<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Teal & Light Slate Master Color System -->
    <Color x:Key="KinpakuGoldColor">#D97706</Color>
    <SolidColorBrush x:Key="KinpakuGoldBrush" Color="{StaticResource KinpakuGoldColor}"/>

    <Color x:Key="VerdigrisPatinaColor">#0D9488</Color>
    <SolidColorBrush x:Key="VerdigrisPatinaBrush" Color="{StaticResource VerdigrisPatinaColor}"/>

    <Color x:Key="SidebarBgColor">#131F28</Color>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>

    <Color x:Key="SidebarNavActiveBgColor">#1C3B3E</Color>
    <SolidColorBrush x:Key="SidebarNavActiveBgBrush" Color="{StaticResource SidebarNavActiveBgColor}"/>

    <Color x:Key="TealPrimaryColor">#134E53</Color>
    <SolidColorBrush x:Key="TealPrimaryBrush" Color="{StaticResource TealPrimaryColor}"/>
    <Color x:Key="TealPrimaryHoverColor">#0F3E42</Color>
    <SolidColorBrush x:Key="TealPrimaryHoverBrush" Color="{StaticResource TealPrimaryHoverColor}"/>

    <Color x:Key="PrimaryColor">#134E53</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <Color x:Key="PrimaryHoverColor">#0F3E42</Color>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>

    <!-- Surfaces -->
    <Color x:Key="BgDarkColor">#F3F5F7</Color>
    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}"/>
    <Color x:Key="CardBgColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}"/>
    <Color x:Key="CardBorderColor">#E2E8F0</Color>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <!-- Status Badges -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#B91C1C"/>

</ResourceDictionary>
