<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Impeccable Kinpaku Gold & Verdigris Patina Palette -->
    <Color x:Key="KinpakuGoldColor">#F59E0B</Color>
    <SolidColorBrush x:Key="KinpakuGoldBrush" Color="{StaticResource KinpakuGoldColor}"/>

    <Color x:Key="VerdigrisPatinaColor">#14B8A6</Color>
    <SolidColorBrush x:Key="VerdigrisPatinaBrush" Color="{StaticResource VerdigrisPatinaColor}"/>

    <Color x:Key="PrimaryColor">#4F46E5</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <Color x:Key="PrimaryHoverColor">#6366F1</Color>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>

    <!-- Surfaces -->
    <Color x:Key="BgDarkColor">#0F172A</Color>
    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}"/>
    <Color x:Key="CardBgColor">#1E293B</Color>
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}"/>
    <Color x:Key="CardBorderColor">#334155</Color>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <Color x:Key="TextMutedColor">#94A3B8</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>

</ResourceDictionary>
