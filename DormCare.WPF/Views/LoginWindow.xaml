<Window x:Class="DormCare.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1fr"/>
            <ColumnDefinition Width="1.2fr"/>
        </Grid.ColumnDefinitions>

        <!-- Left Branding Panel (Impeccable Light Slate / Indigo Gradient Accent) -->
        <Border Grid.Column="0" Background="#1E293B" Padding="48">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource KinpakuGoldBrush}" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                        <TextBlock Text="DC" Foreground="#0F172A" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DormCare" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Hệ Thống Quản Lý Ký Túc Xá" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Middle Value Messaging -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Quản lý ký túc xá thông minh." FontSize="28" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="Nền tảng tập trung kết nối Ban Quản lý, Sinh viên, Phòng ở và các nghĩa vụ lệ phí KTX." FontSize="15" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,24"/>

                    <Border Background="#334155" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="✓ Dữ liệu tập trung SQL Server" Foreground="#F8FAFC" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Text="✓ Phân quyền Quản lý &amp; Sinh viên" Foreground="#F8FAFC" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Text="✓ Quản lý Tòa nhà, Phòng, Giường &amp; Hóa đơn" Foreground="#F8FAFC" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer Copyright -->
                <TextBlock Grid.Row="2" Text="© DormCare System • DB: DormCareDB" FontSize="12" Foreground="#64748B"/>
            </Grid>
        </Border>

        <!-- Right Form Panel (Switchable Login / Register) -->
        <Border Grid.Column="1" Background="#FFFFFF" Padding="48">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center">

                    <!-- Tab Mode Header -->
                    <DockPanel Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding IsRegisterMode, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="ĐĂNG NHẬP" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Quick Preset Role Helper Buttons -->
                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1fr"/>
                                <ColumnDefinition Width="1fr"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="👤 Tài khoản Quản lý" Command="{Binding SelectAdminCommand}" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="🎓 Tài khoản Sinh viên" Command="{Binding SelectStudentCommand}" Style="{StaticResource SecondaryButton}" Height="36" Margin="4,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Feedback Messages -->
                    <Border Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <Border Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisConverter}}" Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#059669" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <!-- LOGIN FORM VIEW -->
                    <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}">
                        <TextBlock Text="Tên đăng nhập" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,16"/>

                        <TextBlock Text="Mật khẩu" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,24"/>

                        <Button Content="🔑 ĐĂNG NHẬP HỆ THỐNG" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButton}" Height="44" FontSize="14" Margin="0,0,0,16"/>

                        <DockPanel HorizontalAlignment="Center">
                            <TextBlock Text="Chưa có tài khoản sinh viên? " Foreground="#64748B" FontSize="13"/>
                            <Button Content="Đăng ký ngay" Command="{Binding ToggleModeCommand}" Style="{StaticResource NavButton}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" Padding="0"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- REGISTER FORM VIEW -->
                    <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisConverter}}">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1fr"/>
                                <ColumnDefinition Width="1fr"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Tên đăng nhập *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RegUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Mã sinh viên *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RegStudentCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1fr"/>
                                <ColumnDefinition Width="1fr"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Họ và tên *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RegFullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Email *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RegEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1fr"/>
                                <ColumnDefinition Width="1fr"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Mật khẩu *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RegPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Xác nhận mật khẩu *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RegConfirmPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1fr"/>
                                <ColumnDefinition Width="1fr"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Ngành học" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RegMajor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Lớp" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RegClassName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="📝 ĐĂNG KÝ TÀI KHOẢN MỚI" Command="{Binding RegisterCommand}" Style="{StaticResource PrimaryButton}" Height="44" FontSize="14" Margin="0,0,0,16"/>

                        <DockPanel HorizontalAlignment="Center">
                            <TextBlock Text="Đã có tài khoản? " Foreground="#64748B" FontSize="13"/>
                            <Button Content="Đăng nhập tại đây" Command="{Binding ToggleModeCommand}" Style="{StaticResource NavButton}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" Padding="0"/>
                        </DockPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
