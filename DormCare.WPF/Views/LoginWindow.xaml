<Window x:Class="DormCare.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DormCare — Đăng nhập hệ thống" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindow}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Branding Banner -->
        <Border Grid.Column="0" CornerRadius="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4F46E5" Offset="0.0"/>
                    <GradientStop Color="#7C3AED" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                <Border Width="80" Height="80" CornerRadius="40" Background="#33FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="🏠" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="DormCare" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Hệ Thống Quản Lý Ký Túc Xá Thông Minh" FontSize="16" Foreground="#E0E7FF" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <Border Height="1" Background="#40FFFFFF" Margin="0,32,0,32"/>
                <TextBlock Text="✨ Giao diện hiện đại • MVVM + 3-Layer Architecture" FontSize="13" Foreground="#C7D2FE" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Right Form Panel -->
        <Border Grid.Column="1" Padding="40" Background="{StaticResource BgDarkBrush}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Đăng Nhập" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Vui lòng nhập thông tin tài khoản của bạn" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,24"/>

                <!-- Preset Role Quick Select -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20" HorizontalAlignment="Center">
                    <Button Content="Tài khoản Quản lý" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Command="{Binding SelectAdminCommand}" Padding="12,6" FontSize="12"/>
                    <Button Content="Tài khoản Sinh viên" Style="{StaticResource PrimaryButton}" Command="{Binding SelectStudentCommand}" Padding="12,6" FontSize="12"/>
                </StackPanel>

                <!-- Username -->
                <TextBlock Text="Tên đăng nhập" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <!-- Password -->
                <TextBlock Text="Mật khẩu" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24"/>

                <!-- Login Button -->
                <Button Content="ĐĂNG NHẬP" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" Height="45" FontSize="15" Margin="0,0,0,16"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
