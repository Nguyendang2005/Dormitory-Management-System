<Window x:Class="DormCare.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DormCare.WPF.ViewModels"
        xmlns:views="clr-namespace:DormCare.WPF.Views"
        xmlns:managerViews="clr-namespace:DormCare.WPF.Views.Manager"
        xmlns:studentViews="clr-namespace:DormCare.WPF.Views.Student"
        xmlns:conv="clr-namespace:DormCare.WPF.Converters"
        Title="{Binding Title}" Height="850" Width="1360"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindow}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>

        <DataTemplate DataType="{x:Type vm:BuildingViewModel}">
            <managerViews:BuildingManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RoomViewModel}">
            <managerViews:RoomManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BedViewModel}">
            <managerViews:BedManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AvailableRoomViewModel}">
            <managerViews:AvailableRoomsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OccupancyStatisticsViewModel}">
            <managerViews:OccupancyStatisticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentViewModel}">
            <managerViews:StudentManagement/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ApplicationViewModel}">
            <managerViews:ApplicationManagement/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvoiceViewModel}">
            <managerViews:InvoiceManagement/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaintenanceViewModel}">
            <managerViews:MaintenanceManagement/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F3F5F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="#131F28">
            <DockPanel Margin="16,20">
                <!-- App Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="8" Background="#FFFFFF" Margin="0,0,12,0">
                            <TextBlock Text="🏢" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DormCare" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Hệ Thống Quản Lý Ký Túc Xá" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Bottom User Profile & Prominent Logout Button Dock -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Border Background="#1C2B36" BorderBrush="#2D4354" BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#0D9488" Margin="0,0,10,0">
                                    <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUser.Username}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="{Binding CurrentUser.Role}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11"/>
                                </StackPanel>
                            </DockPanel>

                            <Button Command="{Binding LogoutCommand}" Cursor="Hand" Height="36">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#991B1B"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,6">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="🚪 " FontSize="14"/>
                                                            <TextBlock Text="Đăng Xuất" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#DC2626"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Scrollable Navigation Menu -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- CƠ SỞ VẬT CHẤT SECTION -->
                        <DockPanel Margin="8,12,8,6">
                            <TextBlock DockPanel.Dock="Right" Text="︿" Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="CƠ SỞ VẬT CHẤT" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        </DockPanel>

                        <Button Content="🏢  Quản Lý Tòa Nhà" Style="{StaticResource SidebarNavButtonActive}" Command="{Binding NavigateBuildingsCommand}" Margin="0,0,0,4"/>
                        <Button Content="🚪  Quản Lý Phòng" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateRoomsCommand}" Margin="0,0,0,4"/>
                        <Button Content="🛏️  Quản Lý Giường" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateBedsCommand}" Margin="0,0,0,4"/>
                        <Button Content="🔍  Tìm Phòng Còn Chỗ" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateAvailableRoomsCommand}" Margin="0,0,0,4"/>
                        <Button Content="📊  Thống Kê Sử Dụng" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateOccupancyStatisticsCommand}" Margin="0,0,0,4"/>

                        <!-- SINH VIÊN & DỊCH VỤ SECTION -->
                        <DockPanel Margin="8,16,8,6">
                            <TextBlock DockPanel.Dock="Right" Text="︿" Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="SINH VIÊN &amp; DỊCH VỤ" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        </DockPanel>

                        <Button Content="👥  Danh Sách Sinh Viên" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateStudentsCommand}" Margin="0,0,0,4"/>
                        <Button Content="📝  Đơn Đăng Ký Phòng" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateApplicationsCommand}" Margin="0,0,0,4"/>
                        <Button Content="💳  Hóa Đơn Điện Nước" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateInvoicesCommand}" Margin="0,0,0,4"/>
                        <Button Content="🛠️  Báo Cáo Sửa Chữa" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateMaintenanceCommand}" Margin="0,0,0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Right Main View Container -->
        <Grid Grid.Column="1" Margin="24">
            <ContentControl Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
