<Window x:Class="DormCare.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DormCare.WPF.ViewModels"
        xmlns:managerViews="clr-namespace:DormCare.WPF.Views.Manager"
        Title="{Binding Title}" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindow}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:BuildingViewModel}">
            <managerViews:BuildingManagement/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RoomViewModel}">
            <managerViews:RoomManagement/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BedViewModel}">
            <managerViews:BedManagement/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AvailableRoomViewModel}">
            <managerViews:AvailableRoomsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OccupancyStatisticsViewModel}">
            <managerViews:OccupancyStatisticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentViewModel}">
            <managerViews:StudentManagement/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ApplicationViewModel}">
            <managerViews:ApplicationManagement/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvoiceViewModel}">
            <managerViews:InvoiceManagement/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaintenanceViewModel}">
            <managerViews:MaintenanceManagement/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Margin="8,12,8,24">
                    <TextBlock Text="DormCare" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Dormitory Management" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,16,0,0"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="Dang xuat" Style="{StaticResource DangerButton}" Command="{Binding LogoutCommand}" Margin="0,16,0,0"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Phong va toa nha" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="8,12,8,6"/>
                        <Button Content="Quan ly toa nha" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateBuildingsCommand}" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,10"/>
                        <Button Content="Quan ly phong" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateRoomsCommand}" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,10"/>
                        <Button Content="Quan ly giuong" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateBedsCommand}" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,10"/>
                        <Button Content="Phong con cho" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateAvailableRoomsCommand}" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,10"/>
                        <Button Content="Thong ke su dung" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateOccupancyCommand}" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,10"/>

                        <TextBlock Text="Sinh vien va dich vu" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="8,16,8,6"/>
                        <Button Content="Quan ly sinh vien" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateStudentsCommand}" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,10"/>
                        <Button Content="Don dang ky phong" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateApplicationsCommand}" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,10"/>
                        <Button Content="Hoa don va thanh toan" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateInvoicesCommand}" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,10"/>
                        <Button Content="Bao cao sua chua" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateMaintenanceCommand}" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,10"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <ContentControl Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
