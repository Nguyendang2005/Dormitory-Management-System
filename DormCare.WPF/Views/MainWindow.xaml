<Window x:Class="DormCare.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DormCare.WPF.ViewModels"
        xmlns:views="clr-namespace:DormCare.WPF.Views"
        xmlns:conv="clr-namespace:DormCare.WPF.Converters"
        Title="{Binding Title}" Height="850" Width="1360"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindow}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Background="#F3F5F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar (Matching Mockup) -->
        <Border Grid.Column="0" Background="#131F28">
            <DockPanel Margin="16,20">
                <!-- App Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="8" Background="#FFFFFF" Margin="0,0,12,0">
                            <TextBlock Text="🏢" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DormCare" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Hệ Thống Quản Lý Ký Túc Xá" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Manager Profile Header Badge -->
                    <Border Background="#1C2B36" CornerRadius="8" Padding="10,8" Margin="0,16,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="⚙️" Foreground="#64748B" VerticalAlignment="Center" Cursor="Hand"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="15" Background="#334155" Margin="0,0,10,0">
                                    <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUser.Username}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="{Binding CurrentUser.Role}" Foreground="#94A3B8" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Bottom Logout Button Dock -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Border Background="#1C2B36" CornerRadius="8" Padding="10,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="🚪" Command="{Binding LogoutCommand}" Style="{StaticResource SidebarNavButton}" Foreground="#EF4444" Padding="6,2" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Background="#334155" Margin="0,0,8,0">
                                    <TextBlock Text="👤" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUser.Username}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="{Binding CurrentUser.Role}" Foreground="#94A3B8" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Scrollable Navigation Menu -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- CƠ SỞ VẬT CHẤT SECTION -->
                        <DockPanel Margin="8,12,8,6">
                            <TextBlock DockPanel.Dock="Right" Text="︿" Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="CƠ SỞ VẬT CHẤT" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        </DockPanel>

                        <Button Content="🏢  Quản Lý Tòa Nhà" Style="{StaticResource SidebarNavButtonActive}" Command="{Binding NavigateBuildingsCommand}" Margin="0,0,0,4"/>
                        <Button Content="🚪  Quản Lý Phòng" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateRoomsCommand}" Margin="0,0,0,4"/>
                        <Button Content="🛏️  Quản Lý Giường" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateBedsCommand}" Margin="0,0,0,4"/>
                        <Button Content="🔍  Tìm Phòng Còn Chỗ" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateAvailableRoomsCommand}" Margin="0,0,0,4"/>
                        <Button Content="📊  Thống Kê Sử Dụng" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateOccupancyStatisticsCommand}" Margin="0,0,0,4"/>

                        <!-- SINH VIÊN & DỊCH VỤ SECTION -->
                        <DockPanel Margin="8,16,8,6">
                            <TextBlock DockPanel.Dock="Right" Text="︿" Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="SINH VIÊN &amp; DỊCH VỤ" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        </DockPanel>

                        <Button Content="👥  Danh Sách Sinh Viên" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateStudentsCommand}" Margin="0,0,0,4"/>
                        <Button Content="📝  Đơn Đăng Ký Phòng" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateApplicationsCommand}" Margin="0,0,0,4"/>
                        <Button Content="💳  Hóa Đơn Điện Nước" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateInvoicesCommand}" Margin="0,0,0,4"/>
                        <Button Content="🛠️  Báo Cáo Sửa Chữa" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateMaintenanceCommand}" Margin="0,0,0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Right Main View Container -->
        <Grid Grid.Column="1" Margin="24">
            <ContentControl Content="{Binding CurrentChildViewModel}"/>
        </Grid>
    </Grid>
</Window>
