<UserControl x:Class="DormCare.WPF.Views.Student.InvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderCard}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="💳 HÓA ĐƠN &amp; THANH TOÁN" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Theo dõi các khoản lệ phí ký túc xá và giả lập thanh toán trực tuyến" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3fr"/>
                <ColumnDefinition Width="1fr"/>
            </Grid.ColumnDefinitions>

            <!-- Invoice List -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                <DockPanel Margin="16">
                    <TextBlock DockPanel.Dock="Top" Text="Danh Sách Hóa Đơn Của Bạn" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Hóa Đơn" Binding="{Binding InvoiceCode}" Width="120"/>
                            <DataGridTextColumn Header="Kỳ Phí" Binding="{Binding BillingMonth, StringFormat={}{0:MM/yyyy}}" Width="90"/>
                            <DataGridTextColumn Header="Tiền Phòng" Binding="{Binding RoomFee, StringFormat={}{0:N0} VNĐ}" Width="110"/>
                            <DataGridTextColumn Header="Tiền Dịch Vụ" Binding="{Binding ServiceFee, StringFormat={}{0:N0} VNĐ}" Width="110"/>
                            <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding TotalAmount, StringFormat={}{0:N0} VNĐ}" Width="120"/>
                            <DataGridTextColumn Header="Hạn Thanh Toán" Binding="{Binding DueDate, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                            <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Payment Simulation Panel -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="12,0,0,0">
                <StackPanel Margin="16">
                    <TextBlock Text="Chi Tiết Hóa Đơn Đang Chọn" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Hóa đơn tháng 07/2026" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Border HorizontalAlignment="Right" Background="#D1FAE5" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Đã thanh toán" Foreground="#059669" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="Mã hóa đơn: INV-2026-0005" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Tiền phòng: 1,500,000 VNĐ" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Phí điện nước dịch vụ: 150,000 VNĐ" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <Separator Background="{StaticResource CardBorderBrush}" Margin="0,0,0,8"/>
                            <DockPanel>
                                <TextBlock Text="TỔNG THÀNH TIỀN:" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="1,650,000 VNĐ" FontWeight="Bold" Foreground="{StaticResource KinpakuGoldBrush}" HorizontalAlignment="Right" FontSize="16"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Button Content="💳 Giả Lập Thanh Toán Online (MockPayment)" Style="{StaticResource PrimaryButton}" Height="40" FontSize="13" Margin="0,0,0,12"/>
                    <TextBlock Text="* Giao dịch giả lập sẽ tự động cập nhật trạng thái hóa đơn thành Paid trong SQL Server." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
