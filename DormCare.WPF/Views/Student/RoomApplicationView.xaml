<UserControl x:Class="DormCare.WPF.Views.Student.RoomApplicationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderCard}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Tim phong con cho" Style="{StaticResource SecondaryButton}" Command="{Binding BackToRoomSearchCommand}" Margin="0,0,8,0"/>
                    <Button Content="Lam moi" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Dang ky phong ky tuc xa" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Xac nhan phong da chon, chon giuong trong va gui yeu cau dang ky" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource CardBorder}"
                    Visibility="{Binding NoSelectedRoom, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Ban chua chon phong" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Ban chua chon phong. Vui long tim va chon mot phong con cho truoc khi dang ky."
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>
                    <Button Content="Tim phong con cho" Style="{StaticResource PrimaryButton}" Command="{Binding BackToRoomSearchCommand}" Width="180" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="0"
                  Visibility="{Binding HasSelectedRoom, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Thong tin phong da chon" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,16,12">
                                <TextBlock Text="So phong" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedRoom.RoomNumber}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Toa nha" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedRoom.BuildingName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,12">
                                <TextBlock Text="Tang" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedRoom.FloorNumber}" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Loai phong" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedRoom.RoomTypeVietnamese}" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,12">
                                <TextBlock Text="Gioi tinh" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedRoom.GenderTypeVietnamese}" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Gia thue" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedRoom.MonthlyRent, StringFormat={}{0:N0} VND}" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Suc chua" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedRoom.Capacity}" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Giuong trong" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedRoom.AvailableBeds}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Form dang ky" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                        <TextBlock Text="Giuong mong muon" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableBeds}"
                                  SelectedItem="{Binding SelectedBed}"
                                  DisplayMemberPath="BedCode"
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="Ly do dang ky" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"
                                 Height="90"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,0,0,16"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Quay lai tim phong" Style="{StaticResource SecondaryButton}" Command="{Binding BackToRoomSearchCommand}" Margin="0,0,8,0"/>
                            <Button Content="Gui yeu cau" Style="{StaticResource PrimaryButton}" Height="40" Command="{Binding SubmitCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Trang thai dang ky cua ban" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding MyApplications}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ma don" Binding="{Binding ApplicationCode}" Width="140"/>
                            <DataGridTextColumn Header="Phong" Binding="{Binding Room.RoomNumber}" Width="80"/>
                            <DataGridTextColumn Header="Giuong" Binding="{Binding PreferredBed.BedCode}" Width="110"/>
                            <DataGridTextColumn Header="Ngay gui" Binding="{Binding ApplicationDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140"/>
                            <DataGridTextColumn Header="Trang thai" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="Ghi chu quan ly" Binding="{Binding ReviewNote}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
