<UserControl x:Class="DormCare.WPF.Views.Student.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderCard}" Margin="0,0,0,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✓ Đánh Dấu Tất Cả Đã Đọc" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🔔 THÔNG BÁO HỆ THỐNG" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Xem tất cả các thông báo từ Ban Quản lý Ký túc xá" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Notification Items Grid -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#FEF3C7" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                                <TextBlock Text="📢" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Thông Báo Phí Ký Túc Xá Tháng 07/2026" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Hóa đơn lệ phí KTX tháng 07/2026 đã được cập nhật. Vui lòng thanh toán trước ngày 10/07/2026." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="26/07/2026 14:00" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#D1FAE5" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                                <TextBlock Text="🎉" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Chào Mừng Đến Với DormCare" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Tài khoản sinh viên của bạn đã được khởi tạo thành công trên hệ thống quản lý ký túc xá." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="25/07/2026 09:00" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
