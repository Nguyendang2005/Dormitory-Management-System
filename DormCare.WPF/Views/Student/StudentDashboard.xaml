<UserControl x:Class="DormCare.WPF.Views.Student.StudentDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DormCare.WPF.Converters"
             xmlns:studentViews="clr-namespace:DormCare.WPF.Views.Student">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="🏫 Trang Chủ Sinh Viên" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Thông tin cá nhân, đăng ký phòng và theo dõi hóa đơn KTX" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="👤 Thông tin cá nhân" Style="{StaticResource SecondaryButton}" Command="{Binding NavigateProfileCommand}" Margin="0,0,8,0"/>
                <Button Content="📝 Đăng ký phòng" Style="{StaticResource SecondaryButton}" Command="{Binding NavigateRoomRegistrationCommand}" Margin="0,0,8,0"/>
                <Button Content="💳 Hóa Đơn &amp; Thanh Toán" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateInvoiceCommand}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid Visibility="{Binding IsProfileVisible, Converter={StaticResource BoolToVisConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardFrame}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Thong tin sinh vien" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryHoverBrush}" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Ma sinh vien:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Student.StudentCode}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Ho va ten:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Student.FullName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Gioi tinh:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Student.Gender}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Nganh hoc:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Student.Major}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Lop:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Student.ClassName}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="So dien thoai:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Student.Phone}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Email:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Student.Email}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardFrame}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Tinh trang cho o" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryHoverBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="Neu chua co phong, hay mo Dang ky phong de chon phong va gui yeu cau." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <DataGrid ItemsSource="{Binding Student.RoomAssignments}" Style="{StaticResource ModernDataGrid}" Height="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Trang thai" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Phong" Binding="{Binding Room.RoomNumber}" Width="90"/>
                                <DataGridTextColumn Header="Toa nha" Binding="{Binding Room.Building.BuildingName}" Width="160"/>
                                <DataGridTextColumn Header="Giuong" Binding="{Binding Bed.BedCode}" Width="120"/>
                                <DataGridTextColumn Header="Ngay bat dau" Binding="{Binding StartDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                                <DataGridTextColumn Header="Ghi chu" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Room Registration Tab -->
            <Grid Visibility="{Binding IsRoomRegistrationVisible, Converter={StaticResource BoolToVisConverter}}">
                <ContentControl Content="{Binding RoomRegistrationViewModel}"/>
            </Grid>

            <!-- Invoice Tab -->
            <Grid Visibility="{Binding IsInvoiceVisible, Converter={StaticResource BoolToVisConverter}}">
                <studentViews:StudentInvoiceView DataContext="{Binding InvoiceViewModel}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
