<UserControl x:Class="DormCare.WPF.Views.Student.StudentDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DormCare.WPF.Converters"
             xmlns:studentViews="clr-namespace:DormCare.WPF.Views.Student"
             xmlns:managerViews="clr-namespace:DormCare.WPF.Views.Manager">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderCard}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="🎓 CỔNG THÔNG TIN SINH VIÊN KÝ TÚC XÁ" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Thông tin cá nhân, xem phòng còn chỗ và hóa đơn KTX" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="👤 Thông tin cá nhân" Style="{StaticResource SecondaryButton}" Command="{Binding NavigateProfileCommand}" Margin="0,0,8,0"/>
                    <Button Content="🔍 Tìm phòng còn chỗ" Style="{StaticResource SecondaryButton}" Command="{Binding NavigateAvailableRoomsCommand}" Margin="0,0,8,0"/>
                    <Button Content="💳 Hóa Đơn &amp; Thanh Toán" Style="{StaticResource SecondaryButton}" Command="{Binding NavigateInvoiceCommand}" Margin="0,0,8,0"/>
                    <Button Content="🛠️ Báo Cáo Sự Cố" Style="{StaticResource SecondaryButton}" Command="{Binding NavigateMaintenanceCommand}" Margin="0,0,8,0"/>
                    <Grid Margin="0,0,8,0">
                        <Button Content="🔔 Thông Báo" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateNotificationsCommand}"/>
                        <Border Background="Red" CornerRadius="10" MinWidth="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding UnreadNotificationsCount}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                        </Border>
                    </Grid>
                    <Button Content="🚪 Đăng Xuất" Style="{StaticResource SmallDangerButton}" Height="36" Padding="12,0" Command="{Binding LogoutCommand}" ToolTip="Đăng xuất khỏi hệ thống"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid Visibility="{Binding IsProfileVisible, Converter={StaticResource BoolToVisConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- Personal Info Card -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="👤 THÔNG TIN SINH VIÊN" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Mã Sinh Viên:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Student.StudentCode}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Họ và Tên:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Student.FullName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Giới Tính:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Student.Gender}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Ngành Học:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Student.Major}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Lớp Sinh Hoạt:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Student.ClassName}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Số Điện Thoại:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Student.Phone}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Email Liên Hệ:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Student.Email}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Current Bed / Room & Application History Cards -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                    <StackPanel>
                        <!-- Current Bed / Room Card -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🛏️ THÔNG TIN CHỖ Ở HIỆN TẠI" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                                <TextBlock Text="Thông tin chi tiết về phòng và giường bạn đang cư trú chính thức." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <DataGrid ItemsSource="{Binding Student.RoomAssignments}" Style="{StaticResource ModernDataGrid}" Height="160" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="90"/>
                                        <DataGridTextColumn Header="Phòng" Binding="{Binding Room.RoomNumber}" Width="80"/>
                                        <DataGridTextColumn Header="Tòa Nhà" Binding="{Binding Room.Building.BuildingName}" Width="130"/>
                                        <DataGridTextColumn Header="Giường" Binding="{Binding Bed.BedCode}" Width="100"/>
                                        <DataGridTextColumn Header="Ngày Bắt Đầu" Binding="{Binding StartDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110"/>
                                        <DataGridTextColumn Header="Ghi Chú" Binding="{Binding Note}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Room Application History Card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="📋 LỊCH SỬ ĐƠN ĐĂNG KÝ PHÒNG" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                                <TextBlock Text="Danh sách các yêu cầu xin ở KTX và kết quả xét duyệt từ Ban Quản Lý." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <DataGrid ItemsSource="{Binding Student.RoomApplications}" Style="{StaticResource ModernDataGrid}" Height="180" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã Đơn" Binding="{Binding ApplicationCode}" Width="140"/>
                                        <DataGridTextColumn Header="Phòng" Binding="{Binding Room.RoomNumber}" Width="80"/>
                                        <DataGridTextColumn Header="Ngày Đăng Ký" Binding="{Binding ApplicationDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="130"/>
                                        <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="100"/>
                                        <DataGridTextColumn Header="Ghi Chú Xét Duyệt" Binding="{Binding ReviewNote}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Available Rooms Tab -->
            <Grid Visibility="{Binding IsAvailableRoomsVisible, Converter={StaticResource BoolToVisConverter}}">
                <managerViews:AvailableRoomsView DataContext="{Binding AvailableRoomsViewModel}"/>
            </Grid>

            <!-- Room Registration Tab -->
            <Grid Visibility="{Binding IsRoomRegistrationVisible, Converter={StaticResource BoolToVisConverter}}">
                <ContentControl Content="{Binding RoomRegistrationViewModel}"/>
            </Grid>

            <!-- Invoice Tab -->
            <Grid Visibility="{Binding IsInvoiceVisible, Converter={StaticResource BoolToVisConverter}}">
                <studentViews:StudentInvoiceView DataContext="{Binding InvoiceViewModel}"/>
            </Grid>

            <!-- Maintenance Tab -->
            <Grid Visibility="{Binding IsMaintenanceVisible, Converter={StaticResource BoolToVisConverter}}">
                <studentViews:MaintenanceRequestView DataContext="{Binding MaintenanceViewModel}"/>
            </Grid>

            <!-- Notifications Tab -->
            <Grid Visibility="{Binding IsNotificationsVisible, Converter={StaticResource BoolToVisConverter}}">
                <studentViews:NotificationsView />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
