<UserControl x:Class="DormCare.WPF.Views.Student.StudentDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DormCare.WPF.Converters">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderCard}" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🎓 CỔNG THÔNG TIN SINH VIÊN KÝ TÚC XÁ" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Thông tin cá nhân, hồ sơ lưu trú và chi tiết chỗ ở hiện tại" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Personal Info Card -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="👤 THÔNG TIN SINH VIÊN" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Mã Sinh Viên:" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Student.StudentCode}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Họ và Tên:" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Student.User.FullName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Ngành Học:" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Student.Major}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Lớp Sinh Hoạt:" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Student.ClassName}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Số Điện Thoại:" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Student.User.PhoneNumber}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Email Liên Hệ:" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Student.User.Email}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Current Bed / Room Card -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="🛏️ THÔNG TIN CHỖ Ở HIỆN TẠI" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Khu / Tòa Nhà:" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Student.CurrentBed.Room.Building.Name, TargetNullValue='Chưa nhận phòng', FallbackValue='Chưa nhận phòng'}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Số Phòng:" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Student.CurrentBed.Room.RoomNumber, TargetNullValue='N/A', FallbackValue='N/A'}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Số Giường:" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Student.CurrentBed.BedNumber, TargetNullValue='N/A', FallbackValue='N/A'}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Giá Thuê / Tháng:" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Student.CurrentBed.Room.PricePerMonth, StringFormat='{}{0:N0} VNĐ', TargetNullValue='0 VNĐ', FallbackValue='0 VNĐ'}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
