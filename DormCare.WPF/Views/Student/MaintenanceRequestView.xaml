<UserControl x:Class="DormCare.WPF.Views.Student.MaintenanceRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderCard}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🛠️ YÊU CẦU SỬA CHỮA &amp; BẢO TRÌ" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Báo cáo các sự cố cơ sở vật chất phòng ở và theo dõi tiến độ xử lý" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Form Create -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                <StackPanel Margin="16">
                    <TextBlock Text="Gửi Báo Cáo Hỏng Hóc Mới" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <!-- Validation Warning Banner -->
                    <Border Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisConverter}}" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#DC2626" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Danh Mục Sự Cố:" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox SelectedIndex="0" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12">
                        <ComboBoxItem Content="Điện (Đèn, Ổ cắm, Quạt)"/>
                        <ComboBoxItem Content="Nước (Vòi, Đường ống, Vệ sinh)"/>
                        <ComboBoxItem Content="Máy lạnh / Điều hòa"/>
                        <ComboBoxItem Content="Nội thất (Giường, Bàn, Tủ)"/>
                    </ComboBox>


                    <TextBlock Text="Tiêu Đề Sự Cố:" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="Mô Tả Chi Tiết:" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16"/>

                    <Button Content="🛠️ Gửi Yêu Cầu Sửa Chữa" Command="{Binding CreateRequestCommand}" Style="{StaticResource PrimaryButton}" Height="40" FontSize="14"/>
                </StackPanel>
            </Border>

            <!-- Request History List -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="12,0,0,0">
                <DockPanel Margin="16">
                    <TextBlock DockPanel.Dock="Top" Text="Lịch Sử Yêu Cầu Đã Gửi" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding Requests}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Yêu Cầu" Binding="{Binding RequestCode}" Width="110"/>
                            <DataGridTextColumn Header="Danh Mục" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="Tiêu Đề" Binding="{Binding Title}" Width="150"/>

                            <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
