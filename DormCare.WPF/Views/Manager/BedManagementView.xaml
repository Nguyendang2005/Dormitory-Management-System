<UserControl x:Class="DormCare.WPF.Views.Manager.BedManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderCard}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,8,0" Style="{StaticResource SearchTextBox}"/>
                    <ComboBox SelectedItem="{Binding SelectedStatusFilter}" Style="{StaticResource ModernComboBox}" Width="150" Margin="0,0,8,0">
                        <ComboBoxItem Content="Tất cả trạng thái"/>
                        <ComboBoxItem Content="Available"/>
                        <ComboBoxItem Content="Occupied"/>
                        <ComboBoxItem Content="Reserved"/>
                        <ComboBoxItem Content="Maintenance"/>
                    </ComboBox>
                    <Button Content="➕ Thêm Giường" Command="{Binding AddBedCommand}" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🛏️ QUẢN LÝ GIƯỜNG KÝ TÚC XÁ" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Theo dõi mã giường cá nhân, tình trạng sử dụng và bảo trì" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- DataGrid Beds -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <DataGrid ItemsSource="{Binding Beds}" SelectedItem="{Binding SelectedBed}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Giường" Binding="{Binding BedCode}" Width="140"/>
                    <DataGridTextColumn Header="Số Giường" Binding="{Binding BedNumber}" Width="100"/>
                    <DataGridTextColumn Header="Số Phòng" Binding="{Binding RoomNumber}" Width="120"/>
                    <DataGridTextColumn Header="Tòa Nhà" Binding="{Binding BuildingName}" Width="160"/>
                    <DataGridTextColumn Header="Mô Tả" Binding="{Binding Description}" Width="250"/>
                    <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="140"/>
                    <DataGridTemplateColumn Header="Thao Tác" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️ Sửa" Command="{Binding DataContext.EditBedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"/>
                                    <Button Content="🗑️ Xóa" Command="{Binding DataContext.DeleteBedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" Style="{StaticResource SmallDangerButton}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
