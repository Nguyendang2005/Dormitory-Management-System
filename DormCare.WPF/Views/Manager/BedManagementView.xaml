<UserControl x:Class="DormCare.WPF.Views.Manager.BedManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DormCare.WPF.Converters">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusColorConverter"/>
        <conv:StatusToVietnameseConverter x:Key="StatusVietnameseConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Panel (Soft Sky / Clean Cream Style) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleViewModeCommand}" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,10,0" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 " FontSize="13"/>
                            <TextBlock Text="Đổi Chế Độ Xem" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Content="⟳ Tải Lại Dữ Liệu" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" Height="38"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛏️ " FontSize="22"/>
                        <TextBlock Text="QUẢN LÝ GIƯỜNG KÝ TÚC XÁ" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock Text="Theo dõi sinh viên đang ở, mã giường cá nhân và cập nhật trạng thái giường theo thời gian thực từ Database" FontSize="13" Foreground="#475569" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3 Dynamic Metric Cards Row (Real Database Calculations) -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="10" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,14,0">
                        <TextBlock Text="🛏️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TỔNG SỐ GIƯỜNG" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock Text="{Binding TotalBedsCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="16" Margin="4,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="10" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Margin="0,0,14,0">
                        <TextBlock Text="🟢" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GIƯỜNG TRỐNG" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock Text="{Binding AvailableBedsCount}" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="16" Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="10" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,14,0">
                        <TextBlock Text="👤" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ĐANG SỬ DỤNG" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock Text="{Binding OccupiedBedsCount}" FontSize="24" FontWeight="Bold" Foreground="#0284C7" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filter Bar Row (Soft Sky Light Theme) -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Margin="0,0,0,16" Padding="14,10">
            <DockPanel>
                <WrapPanel VerticalAlignment="Center">
                    <!-- Search Input -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Width="260" Height="38" Margin="0,0,10,0" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" Background="Transparent" Foreground="#0F172A" VerticalAlignment="Center" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Status Filter ComboBox -->
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}" Style="{StaticResource ModernComboBox}" Width="180" Height="38"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Content Area: Soft Sky Blue & Cream Light Cards Grid View (Default) or DataGrid View -->
        <Grid Grid.Row="3">
            <!-- 1. SOFT SKY BLUE & CREAM LIGHT CARD GRID VIEW -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Beds}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Margin="0,0,14,14" Padding="16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.08" ShadowDepth="3"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Card Header: Bed Code Badge, Room & Building, Status -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                        <!-- Status Badge Right -->
                                        <Border DockPanel.Dock="Right" Background="{Binding Status, Converter={StaticResource StatusColorConverter}}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusVietnameseConverter}}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                        </Border>

                                        <!-- Bed Code & Room Left -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding BedCode}" FontWeight="Bold" FontSize="13" Foreground="#0284C7"/>
                                            </Border>
                                            <TextBlock Text="{Binding RoomNumber, StringFormat='{}P.{0}'}" FontWeight="Bold" FontSize="15" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Building Line -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="🏢 " FontSize="12" Foreground="#0284C7"/>
                                        <TextBlock Text="{Binding BuildingName}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                    </StackPanel>

                                    <!-- Middle Details Recessed Panel (Soft Light Sky Panel) -->
                                    <Border Grid.Row="2" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="👤 Sinh Viên Đang Ở:" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                                                <TextBlock Text="{Binding StudentName}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock Text="📝 Ghi Chú:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Description, TargetNullValue='-'}" FontSize="11" Foreground="#334155" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Actions Footer: Quick Status Change Buttons -->
                                    <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                        <UniformGrid Columns="3">
                                            <Button Content="🟢 Trống" Command="{Binding DataContext.SetAvailableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="#DCFCE7" Foreground="#15803D" BorderBrush="#86EFAC" BorderThickness="1" Height="32" FontSize="11" FontWeight="Bold" Margin="0,0,4,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <Button Content="🔴 Đang ở" Command="{Binding DataContext.SetOccupiedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1" Height="32" FontSize="11" FontWeight="Bold" Margin="2,0,2,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <Button Content="🛠️ Bảo trì" Command="{Binding DataContext.SetMaintenanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="#FEF3C7" Foreground="#B45309" BorderBrush="#FDE68A" BorderThickness="1" Height="32" FontSize="11" FontWeight="Bold" Margin="4,0,0,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </UniformGrid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 2. DATA GRID VIEW (Alternative Table Mode) -->
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Visibility="{Binding IsTableView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid ItemsSource="{Binding Beds}" SelectedItem="{Binding SelectedBed}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Giường" Binding="{Binding BedCode}" Width="120" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Số Giường" Binding="{Binding BedNumber}" Width="85"/>
                        <DataGridTextColumn Header="Phòng" Binding="{Binding RoomNumber, StringFormat='{}P.{0}'}" Width="90" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Tòa Nhà" Binding="{Binding BuildingName}" Width="110"/>
                        <DataGridTextColumn Header="Sinh Viên Đang Ở" Binding="{Binding StudentName}" Width="160" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Mã SV" Binding="{Binding StudentCode}" Width="100"/>
                        <DataGridTextColumn Header="Ngày Bắt Đầu" Binding="{Binding StartDateDisplay}" Width="110"/>

                        <!-- Status Column -->
                        <DataGridTemplateColumn Header="Trạng Thái" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StatusColorConverter}}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusVietnameseConverter}}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions Column -->
                        <DataGridTemplateColumn Header="Đổi Trạng Thái" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="🟢 Trống" Command="{Binding DataContext.SetAvailableCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#DCFCE7" Foreground="#15803D" BorderBrush="#86EFAC" BorderThickness="1" Height="28" Padding="6,0" FontSize="11" FontWeight="Bold" Margin="0,0,4,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button Content="🔴 Đang ở" Command="{Binding DataContext.SetOccupiedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1" Height="28" Padding="6,0" FontSize="11" FontWeight="Bold" Margin="0,0,4,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button Content="🛠️ Bảo trì" Command="{Binding DataContext.SetMaintenanceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#FEF3C7" Foreground="#B45309" BorderBrush="#FDE68A" BorderThickness="1" Height="28" Padding="6,0" FontSize="11" FontWeight="Bold">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
