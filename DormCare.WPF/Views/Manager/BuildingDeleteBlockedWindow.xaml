<Window x:Class="DormCare.WPF.Views.Manager.BuildingDeleteBlockedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Không Thể Xóa Tòa Nhà" Height="440" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFFFFF" Foreground="#0F172A">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="44" Height="44" CornerRadius="10" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Margin="0,0,12,0" DockPanel.Dock="Left">
                <TextBlock Text="⚠️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Không thể xóa tòa nhà" FontSize="18" FontWeight="Bold" Foreground="#DC2626"/>
                <TextBlock Text="{Binding BuildingName, StringFormat='{}{0} đang có dữ liệu được sử dụng:'}" FontSize="13" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Content Card -->
        <Border Grid.Row="1" Background="#FFFBEB" CornerRadius="10" Padding="16" BorderBrush="#FDE68A" BorderThickness="1" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Tòa nhà hiện đang có dữ liệu liên quan trong hệ thống:" FontSize="13" FontWeight="SemiBold" Foreground="#92400E" Margin="0,0,0,10" TextWrapping="Wrap"/>
                
                <Border Background="#FFFFFF" CornerRadius="8" Padding="14,10" BorderBrush="#FCD34D" BorderThickness="1" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding DeleteResult.TotalRooms, StringFormat='• {0} phòng'}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DeleteResult.TotalBeds, StringFormat='• {0} giường'}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DeleteResult.ResidingStudents, StringFormat='• {0} sinh viên đang cư trú'}" FontSize="13" FontWeight="Bold" Foreground="#0284C7"/>
                    </StackPanel>
                </Border>
                
                <TextBlock Text="⚠️ Xóa tòa nhà sẽ làm mất dữ liệu liên quan. Bạn có muốn chuyển trạng thái tòa nhà sang 'Inactive' thay vì xóa không?" FontSize="12" Foreground="#78350F" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Actions Footer -->
        <Border Grid.Row="2" Padding="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="90" Height="38" Margin="0,0,10,0"/>
                <Button Content="Chuyển sang Inactive" Click="Deactivate_Click" Style="{StaticResource PrimaryButton}" Background="#D97706" Width="170" Height="38"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
