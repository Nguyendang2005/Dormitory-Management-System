<UserControl x:Class="DormCare.WPF.Views.Manager.BuildingManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DormCare.WPF.Converters">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Panel (Soft Sky / Clean Cream Style) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleViewModeCommand}" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,10,0" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 " FontSize="13"/>
                            <TextBlock Text="Đổi Chế Độ Xem" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Content="➕ Thêm Tòa Nhà" Command="{Binding AddBuildingCommand}" Style="{StaticResource PrimaryButton}" Height="38"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏢 " FontSize="22"/>
                        <TextBlock Text="QUẢN LÝ TÒA NHÀ KÝ TÚC XÁ" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock Text="Quản lý cơ sở vật chất, số tầng, số phòng và theo dõi tỷ lệ lấp đầy" FontSize="13" Foreground="#475569" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3 Dynamic Metric Cards Row (Soft Cream / Sky Accents) -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="10" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,14,0">
                        <TextBlock Text="🏢" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TỔNG SỐ TÒA NHÀ" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock Text="{Binding TotalBuildingsCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="16" Margin="4,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="10" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,14,0">
                        <TextBlock Text="🚪" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TỔNG SỐ PHÒNG" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock Text="{Binding TotalRoomsCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="16" Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="10" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Margin="0,0,14,0">
                        <TextBlock Text="🛏️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GIƯỜNG CÒN TRỐNG" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock Text="{Binding TotalAvailableBedsCount}" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filter Bar Row (Soft Sky Light Theme) -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Margin="0,0,0,16" Padding="14,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="⟳ Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Height="38" VerticalAlignment="Center"/>

                <WrapPanel VerticalAlignment="Center">
                    <!-- Search Box -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Width="240" Height="38" Margin="0,0,10,0" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" Background="Transparent" Foreground="#0F172A" VerticalAlignment="Center" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Filter Status ComboBox -->
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}" Style="{StaticResource ModernComboBox}" Width="150" Height="38" Margin="0,0,10,0"/>

                    <!-- Dynamic Floor Filter ComboBox -->
                    <ComboBox ItemsSource="{Binding FloorFilterOptions}" SelectedItem="{Binding SelectedFloorFilter}" Style="{StaticResource ModernComboBox}" Width="140" Height="38" Margin="0,0,10,0"/>

                    <!-- Occupancy Rate Filter ComboBox -->
                    <ComboBox ItemsSource="{Binding OccupancyFilterOptions}" SelectedItem="{Binding SelectedOccupancyFilter}" Style="{StaticResource ModernComboBox}" Width="170" Height="38" Margin="0,0,10,0"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Content Area: Soft Sky Blue / Cream Light Cards Grid View (Default) or DataGrid View -->
        <Grid Grid.Row="3">
            <!-- 1. SOFT SKY BLUE & CREAM LIGHT CARD GRID VIEW -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Buildings}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Margin="0,0,14,14" Padding="16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.08" ShadowDepth="3"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Card Header: Code Badge, Name, Status -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                        <!-- Status Badge Right -->
                                        <Border DockPanel.Dock="Right" Background="{Binding Status, Converter={StaticResource StatusColorConverter}}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                        </Border>

                                        <!-- Code Badge & Name Left -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding BuildingCode}" FontWeight="Bold" FontSize="13" Foreground="#0284C7"/>
                                            </Border>
                                            <TextBlock Text="{Binding BuildingName}" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Address Line -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="📍 " FontSize="12" Foreground="#0284C7"/>
                                        <TextBlock Text="{Binding Address}" FontSize="12" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- 3-Column Mini Metrics Box (Soft Light Sky Panel) -->
                                    <Border Grid.Row="2" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                        <UniformGrid Columns="3">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Số Tầng" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding NumberOfFloors}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Tổng Phòng" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding TotalRooms}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Giường Trống" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding AvailableBeds}" FontSize="16" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>

                                    <!-- Occupancy Progress Bar -->
                                    <StackPanel Grid.Row="3" Margin="0,0,0,14">
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Tỷ Lệ Lấp Đầy" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBlock Text="{Binding OccupancyText, StringFormat='{} ( {0} giường ) '}" FontSize="11" Foreground="#64748B" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding OccupancyRate, StringFormat='{}{0:F1}%'}" FontSize="12" FontWeight="Bold" Foreground="#0284C7"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Grid Height="8">
                                            <Border Background="#E0F2FE" CornerRadius="4"/>
                                            <ProgressBar Value="{Binding OccupancyRate, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" BorderThickness="0" Background="Transparent" Foreground="#0284C7"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Actions Footer with Clean Light Theme Buttons -->
                                    <Border Grid.Row="4" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                        <UniformGrid Columns="3">
                                            <Button Content="👁 Chi tiết" Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1" Height="34" FontSize="11" FontWeight="Bold" Margin="0,0,4,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <Button Content="✏️ Sửa" Command="{Binding DataContext.EditBuildingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="#FFFBEB" Foreground="#B45309" BorderBrush="#FDE68A" BorderThickness="1" Height="34" FontSize="11" FontWeight="Bold" Margin="2,0,2,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <Button Content="🗑️ Xóa" Command="{Binding DataContext.DeleteBuildingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Height="34" FontSize="11" FontWeight="Bold" Margin="4,0,0,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </UniformGrid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 2. DATA GRID VIEW (Alternative Table Mode) -->
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Visibility="{Binding IsTableView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid ItemsSource="{Binding Buildings}" SelectedItem="{Binding SelectedBuilding}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Tòa" Binding="{Binding BuildingCode}" Width="85" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Tên Tòa Nhà" Binding="{Binding BuildingName}" Width="160" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Địa Chỉ" Binding="{Binding Address}" Width="240"/>
                        <DataGridTextColumn Header="Số Tầng" Binding="{Binding NumberOfFloors}" Width="80"/>
                        <DataGridTextColumn Header="Tổng Phòng" Binding="{Binding TotalRooms}" Width="100"/>
                        <DataGridTextColumn Header="Tổng Giường" Binding="{Binding TotalBeds}" Width="105"/>
                        <DataGridTextColumn Header="Giường Trống" Binding="{Binding AvailableBeds}" Width="105" FontWeight="Bold" Foreground="#059669"/>

                        <!-- Occupancy Rate Progress Column -->
                        <DataGridTemplateColumn Header="Tỷ Lệ Lấp Đầy" Width="210">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding OccupancyText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Value="{Binding OccupancyRate, Mode=OneWay}" Minimum="0" Maximum="100" Height="10" BorderThickness="0" Background="#E0F2FE" Foreground="#0284C7" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding OccupancyRate, StringFormat='{}{0:F1}%'}" FontSize="11" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Column -->
                        <DataGridTemplateColumn Header="Trạng Thái" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StatusColorConverter}}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions Column -->
                        <DataGridTemplateColumn Header="Hành Động" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="👁 Chi tiết" Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Content="✏️ Sửa" Command="{Binding DataContext.EditBuildingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Content="🗑️ Xóa" Command="{Binding DataContext.DeleteBuildingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource IconButton}" Padding="8,4" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
