<UserControl x:Class="DormCare.WPF.Views.Manager.BuildingManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <Border Grid.Row="0" Style="{StaticResource HeaderCard}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,10,0" Style="{StaticResource SearchTextBox}"/>
                    <ComboBox SelectedItem="{Binding SelectedStatusFilter}" Style="{StaticResource ModernComboBox}" Width="150" Margin="0,0,10,0">
                        <ComboBoxItem Content="Tất cả trạng thái"/>
                        <ComboBoxItem Content="Còn hoạt động"/>
                        <ComboBoxItem Content="Bảo trì"/>
                    </ComboBox>
                    <Button Content="➕ Thêm Tòa Nhà" Command="{Binding AddBuildingCommand}" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🏢 QUẢN LÝ TÒA NHÀ KÝ TÚC XÁ" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Quản lý cơ sở vật chất, số tầng, số phòng và theo dõi tỷ lệ lấp đầy" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- DataGrid Buildings -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <DataGrid ItemsSource="{Binding Buildings}" SelectedItem="{Binding SelectedBuilding}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Tòa" Binding="{Binding BuildingCode}" Width="90"/>
                    <DataGridTextColumn Header="Tên Tòa Nhà" Binding="{Binding BuildingName}" Width="180"/>
                    <DataGridTextColumn Header="Địa Chỉ" Binding="{Binding Address}" Width="250"/>
                    <DataGridTextColumn Header="Số Tầng" Binding="{Binding NumberOfFloors}" Width="80"/>
                    <DataGridTextColumn Header="Tổng Phòng" Binding="{Binding TotalRooms}" Width="100"/>
                    <DataGridTextColumn Header="Tổng Giường" Binding="{Binding TotalBeds}" Width="100"/>
                    <DataGridTextColumn Header="Đang Sử Dụng" Binding="{Binding OccupiedBeds}" Width="110"/>
                    <DataGridTextColumn Header="Giường Trống" Binding="{Binding AvailableBeds}" Width="110"/>
                    <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="120"/>
                    <DataGridTemplateColumn Header="Thao Tác" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️ Sửa" Command="{Binding DataContext.EditBuildingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"/>
                                    <Button Content="🗑️ Xóa" Command="{Binding DataContext.DeleteBuildingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" Style="{StaticResource SmallDangerButton}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
