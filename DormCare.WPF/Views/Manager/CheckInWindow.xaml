<Window x:Class="DormCare.WPF.Views.Manager.CheckInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DormCare.WPF.Converters"
        Title="{Binding Title}" Height="480" Width="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A" Foreground="White">

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🔑 Nhận Phòng Ký Túc Xá" FontSize="22" FontWeight="Bold" Foreground="{StaticResource KinpakuGoldBrush}"/>
            <TextBlock Text="Chọn tòa nhà, phòng và giường còn trống để Check-in" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form Content -->
        <StackPanel Grid.Row="1">
            <!-- Error Message -->
            <Border Background="#33EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <!-- Student Info Display -->
            <Border Style="{StaticResource CardFrame}" Padding="16" Margin="0,0,0,20" Background="#1E293B">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="👤 Sinh Viên" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding StudentName}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="🆔 Mã Số" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding StudentCode}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="🚻 Giới Tính" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding StudentGender}" FontSize="14" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Selection Dropdowns -->
            <!-- Building -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="🏢 Chọn Tòa Nhà (*)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Buildings}" SelectedItem="{Binding SelectedBuilding}" Height="38" Style="{StaticResource ModernComboBox}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding BuildingName}" Foreground="White" FontSize="13"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Room & Bed Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🚪 Chọn Phòng (*)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" Height="38" Style="{StaticResource ModernComboBox}"
                              IsEnabled="{Binding IsRoomSelectionEnabled}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RoomNumber}" Foreground="White" FontSize="13"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="🛏️ Chọn Giường (*)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Beds}" SelectedItem="{Binding SelectedBed}" Height="38" Style="{StaticResource ModernComboBox}"
                              IsEnabled="{Binding IsBedSelectionEnabled}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BedNumber}" Foreground="White" FontSize="13"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy bỏ" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Width="110" Height="40" Margin="0,0,12,0"/>
            <Button Content="🔑 Xác nhận" Style="{StaticResource PrimaryButton}" Command="{Binding CheckInCommand}" Width="130" Height="40"/>
        </StackPanel>
    </Grid>
</Window>
