<UserControl x:Class="DormCare.WPF.Views.Manager.OccupancyStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DormCare.WPF.Converters">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusColorConverter"/>
        <conv:StatusToVietnameseConverter x:Key="StatusVietnameseConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="📊 Tổng Quan Tình Trạng Sử Dụng" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Báo cáo thống kê tình trạng lấp đầy phòng ở và giường ký túc xá theo thời gian thực" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="🔄 Tải Lại Dữ Liệu" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Stats Metric Grid -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
            <Border Style="{StaticResource CardFrame}" Margin="0,0,10,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Tổng Số Tòa Nhà" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Statistics.TotalBuildings}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardFrame}" Margin="0,0,10,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Tổng Số Phòng / Giường" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Statistics.TotalRooms}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text=" phòng / " FontSize="18" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,4,4"/>
                        <TextBlock Text="{Binding Statistics.TotalBeds}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryHoverBrush}"/>
                        <TextBlock Text=" giường" FontSize="18" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardFrame}" Margin="0,0,10,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Giường Đang Sử Dụng / Còn Trống" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Statistics.OccupiedBeds}" FontSize="28" FontWeight="Bold" Foreground="#3B82F6"/>
                        <TextBlock Text=" / " FontSize="22" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,4,2"/>
                        <TextBlock Text="{Binding Statistics.AvailableBeds}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource KinpakuGoldBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardFrame}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Tỷ Lệ Lấp Đầy Toàn Ký Túc Xá" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Statistics.OverallOccupancyRate, StringFormat='{}{0:F1}%'}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource KinpakuGoldBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Building Breakdown Table -->
        <Border Grid.Row="2" Style="{StaticResource CardFrame}">
            <StackPanel>
                <TextBlock Text="🏢 Thống Kê Theo Tòa Nhà" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                <DataGrid ItemsSource="{Binding Statistics.BuildingBreakdown}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="42">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Tòa" Binding="{Binding BuildingCode}" Width="100"/>
                        <DataGridTextColumn Header="Tên Tòa Nhà" Binding="{Binding BuildingName}" Width="180" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Số Tầng" Binding="{Binding NumberOfFloors}" Width="90"/>
                        <DataGridTextColumn Header="Tổng Số Phòng" Binding="{Binding TotalRooms}" Width="120"/>
                        <DataGridTextColumn Header="Tổng Số Giường" Binding="{Binding TotalBeds}" Width="130"/>
                        <DataGridTextColumn Header="Đang Sử Dụng" Binding="{Binding OccupiedBeds}" Width="120" FontWeight="Bold" Foreground="#3B82F6"/>
                        <DataGridTextColumn Header="Còn Trống" Binding="{Binding AvailableBeds}" Width="110" FontWeight="Bold" Foreground="{StaticResource KinpakuGoldBrush}"/>
                        <DataGridTextColumn Header="Bảo Trì" Binding="{Binding MaintenanceBeds}" Width="100" Foreground="#F59E0B"/>
                        <DataGridTextColumn Header="Tỷ Lệ Lấp Đầy (%)" Binding="{Binding OccupancyRate, StringFormat='{}{0:F1}%'}" Width="150" FontWeight="Bold" Foreground="{StaticResource KinpakuGoldBrush}"/>
                        <DataGridTemplateColumn Header="Trạng Thái Tòa" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                            CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusVietnameseConverter}}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
