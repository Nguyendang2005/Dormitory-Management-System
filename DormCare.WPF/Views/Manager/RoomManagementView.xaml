<UserControl x:Class="DormCare.WPF.Views.Manager.RoomManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DormCare.WPF.Converters">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Panel (Soft Sky / Clean Cream Style) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleViewModeCommand}" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,10,0" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 " FontSize="13"/>
                            <TextBlock Text="Đổi Chế Độ Xem" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Content="➕ Thêm Phòng" Command="{Binding AddRoomCommand}" Style="{StaticResource PrimaryButton}" Height="38"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚪 " FontSize="22"/>
                        <TextBlock Text="QUẢN LÝ PHÒNG Ở KÝ TÚC XÁ" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock Text="Hiển thị sức chứa, số giường đang sử dụng và đơn giá phòng thực tế từ Database" FontSize="13" Foreground="#475569" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3 Dynamic Metric Cards Row (Real Database Calculations) -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="10" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,14,0">
                        <TextBlock Text="🚪" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TỔNG SỐ PHÒNG" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock Text="{Binding TotalRoomsCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="16" Margin="4,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="10" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,14,0">
                        <TextBlock Text="🛏️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TỔNG SỐ GIƯỜNG" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock Text="{Binding TotalBedsCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="16" Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="10" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Margin="0,0,14,0">
                        <TextBlock Text="🟢" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SỐ PHÒNG CÒN TRỐNG" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock Text="{Binding AvailableRoomsCount}" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filter Bar Row (Soft Sky Light Theme) -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Margin="0,0,0,16" Padding="14,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="⟳ Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Height="38" VerticalAlignment="Center"/>

                <WrapPanel VerticalAlignment="Center">
                    <!-- Search Input -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Width="240" Height="38" Margin="0,0,10,0" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" Background="Transparent" Foreground="#0F172A" VerticalAlignment="Center" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Building Filter ComboBox -->
                    <ComboBox ItemsSource="{Binding BuildingFilterOptions}" SelectedItem="{Binding SelectedBuildingFilter}" Style="{StaticResource ModernComboBox}" Width="160" Height="38" Margin="0,0,10,0"/>

                    <!-- Room Type Filter ComboBox -->
                    <ComboBox ItemsSource="{Binding TypeFilterOptions}" SelectedItem="{Binding SelectedTypeFilter}" Style="{StaticResource ModernComboBox}" Width="150" Height="38" Margin="0,0,10,0"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Content Area: Soft Sky Blue & Cream Light Cards Grid View (Default) or DataGrid View -->
        <Grid Grid.Row="3">
            <!-- 1. SOFT SKY BLUE & CREAM LIGHT CARD GRID VIEW -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Rooms}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Margin="0,0,14,14" Padding="16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.08" ShadowDepth="3"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Card Header: Room Badge, Building Name, Status -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                        <!-- Status Badge Right -->
                                        <Border DockPanel.Dock="Right" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusDisplay}" Value="Đã đầy">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusDisplay}" Value="Bảo trì">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusDisplay}" Value="Vô hiệu">
                                                            <Setter Property="Background" Value="#E2E8F0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusDisplay}" Value="Đã đầy">
                                                                <Setter Property="Foreground" Value="#B91C1C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusDisplay}" Value="Bảo trì">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusDisplay}" Value="Vô hiệu">
                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Room Badge & Building Name Left -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding RoomNumber}" FontWeight="Bold" FontSize="14" Foreground="#0284C7"/>
                                            </Border>
                                            <TextBlock Text="{Binding BuildingName}" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Floor Line -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="🏢 " FontSize="12" Foreground="#0284C7"/>
                                        <TextBlock Text="{Binding FloorNumber, StringFormat='{}Tầng {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,12,0"/>
                                        <TextBlock Text="•" FontSize="12" Foreground="#94A3B8" Margin="0,0,12,0"/>
                                        <TextBlock Text="Loại: " FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding RoomType}" FontSize="12" FontWeight="Bold" Foreground="#0F172A"/>
                                    </StackPanel>

                                    <!-- 3-Column Mini Metrics Box (Soft Light Sky Panel) -->
                                    <Border Grid.Row="2" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                        <UniformGrid Columns="3">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Sức Chứa" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Capacity, StringFormat='{}{0} giường'}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Giá Thuê / Tháng" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding MonthlyRent, StringFormat='{}{0:N0} đ'}" FontSize="14" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Đối Tượng" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding GenderType}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>

                                    <!-- Occupancy Progress Bar -->
                                    <StackPanel Grid.Row="3" Margin="0,0,0,14">
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Tình Trạng Chỗ Ở" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBlock Text="{Binding OccupancySummary}" FontSize="11" Foreground="#64748B" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding OccupancyRate, StringFormat='{} ({0:F1}%)'}" FontSize="12" FontWeight="Bold" Foreground="#0284C7"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Grid Height="8">
                                            <Border Background="#E0F2FE" CornerRadius="4"/>
                                            <ProgressBar Value="{Binding OccupancyRate, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" BorderThickness="0" Background="Transparent" Foreground="#0284C7"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Actions Footer with Clean Light Theme Buttons -->
                                    <Border Grid.Row="4" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                        <UniformGrid Columns="3">
                                            <Button Content="👁 Chi tiết" Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1" Height="34" FontSize="11" FontWeight="Bold" Margin="0,0,4,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <Button Content="✏️ Sửa" Command="{Binding DataContext.EditRoomCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="#FFFBEB" Foreground="#B45309" BorderBrush="#FDE68A" BorderThickness="1" Height="34" FontSize="11" FontWeight="Bold" Margin="2,0,2,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <Button Content="🗑️ Xóa" Command="{Binding DataContext.DeleteRoomCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Height="34" FontSize="11" FontWeight="Bold" Margin="4,0,0,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </UniformGrid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 2. DATA GRID VIEW (Alternative Table Mode) -->
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Visibility="{Binding IsTableView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Số Phòng" Binding="{Binding RoomNumber}" Width="100" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Tòa Nhà" Binding="{Binding BuildingName}" Width="140"/>
                        <DataGridTextColumn Header="Tầng" Binding="{Binding FloorNumber, StringFormat='{}Tầng {0}'}" Width="85"/>
                        <DataGridTextColumn Header="Loại Phòng" Binding="{Binding RoomType}" Width="110"/>
                        <DataGridTextColumn Header="Sức Chứa" Binding="{Binding Capacity, StringFormat='{}{0} giường'}" Width="100"/>
                        <DataGridTextColumn Header="Tình Trạng Chỗ Ở" Binding="{Binding OccupancySummary}" Width="160" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Giá Thuê / Tháng" Binding="{Binding MonthlyRent, StringFormat={}{0:N0} VNĐ}" Width="150" FontWeight="Bold" Foreground="#0284C7"/>
                        <DataGridTextColumn Header="Đối Tượng" Binding="{Binding GenderType}" Width="100"/>

                        <!-- Status Column -->
                        <DataGridTemplateColumn Header="Trạng Thái" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusDisplay}" Value="Còn chỗ">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusDisplay}" Value="Đã đầy">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusDisplay}" Value="Bảo trì">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusDisplay}" Value="Vô hiệu">
                                                        <Setter Property="Background" Value="#E2E8F0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#475569"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusDisplay}" Value="Còn chỗ">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusDisplay}" Value="Đã đầy">
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusDisplay}" Value="Bảo trì">
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusDisplay}" Value="Vô hiệu">
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions Column with 👁 Chi tiết, ✏️ Sửa, 🗑️ Xóa -->
                        <DataGridTemplateColumn Header="Hành Động" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="👁 Chi tiết" Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1" Height="30" Padding="8,0" FontSize="11" FontWeight="Bold" Margin="0,0,6,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button Content="✏️ Sửa" Command="{Binding DataContext.EditRoomCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#FFFBEB" Foreground="#B45309" BorderBrush="#FDE68A" BorderThickness="1" Height="30" Padding="8,0" FontSize="11" FontWeight="Bold" Margin="0,0,6,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button Content="🗑️ Xóa" Command="{Binding DataContext.DeleteRoomCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Height="30" Padding="8,0" FontSize="11" FontWeight="Bold">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
