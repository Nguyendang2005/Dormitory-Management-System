<Window x:Class="DormCare.WPF.Views.Manager.CreateInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DormCare.WPF.Converters"
        Title="{Binding Title}" Height="620" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A" Foreground="White">

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="➕ Tạo Hóa Đơn Mới" FontSize="22" FontWeight="Bold" Foreground="{StaticResource KinpakuGoldBrush}"/>
            <TextBlock Text="Nhập thông tin khoản phí cho sinh viên &amp; phòng ký túc xá" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Error Message -->
                <Border Background="#33EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <!-- Student & Room Selection -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="👤 Chọn Sinh Viên (*)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" Height="38" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource CardBorderBrush}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FullName, StringFormat='{}{0}'}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="🏠 Chọn Phòng (*)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" Height="38" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource CardBorderBrush}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RoomNumber, StringFormat='Phòng {0} ({1})'}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Billing Period & Due Date -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📅 Tháng Thu" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding Month, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="📅 Năm Thu" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="⏰ Hạn Thanh Toán" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <DatePicker SelectedDate="{Binding DueDate}" Height="38" Background="#1E293B" Foreground="White"/>
                    </StackPanel>
                </Grid>

                <!-- Fee Details Grid -->
                <Border Style="{StaticResource CardFrame}" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="💰 CHI TIẾT CÁC KHOẢN PHÍ (VNĐ)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryHoverBrush}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tiền Phòng:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding RoomFee, StringFormat='{}{0:0.#}', UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tiền Điện (Service Fee):" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding ElectricityFee, StringFormat='{}{0:0.#}', UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tiền Nước (Water Fee):" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding WaterFee, StringFormat='{}{0:0.#}', UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Phí Khác / Phí Khống:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding OtherFee, StringFormat='{}{0:0.#}', UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Giảm Giá / Miễn Giam:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding DiscountAmount, StringFormat='{}{0:0.#}', UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Live Total Fee Summary Card -->
                <Border Background="#1E293B" BorderBrush="{StaticResource KinpakuGoldBrush}" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="🧮 TỔNG CỘNG HÓA ĐƠN (LIVE CALCULATED)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="= Tiền Phòng + Điện + Nước + Khác - Giảm Giá" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TotalAmount, StringFormat='{}{0:N0} VNĐ'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource KinpakuGoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Note -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="📝 Ghi Chú Hóa Đơn" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy Bỏ" Width="100" Height="36" Style="{StaticResource PrimaryButton}" Background="#334155" Command="{Binding CancelCommand}" Margin="0,0,10,0"/>
            <Button Content="💾 Lưu Hóa Đơn" Width="140" Height="36" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
