<UserControl x:Class="DormCare.WPF.Views.Manager.StudentManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header & Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Quản Lý Sinh Viên" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Quản lý hồ sơ học viên, thông tin lưu trú, nhận/trả phòng ký túc xá" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="➕ Thêm mới" Style="{StaticResource PrimaryButton}" Command="{Binding AddStudentCommand}" Margin="0,0,8,0"/>
                <Button Content="✏️ Sửa đổi" Style="{StaticResource SecondaryButton}" Command="{Binding EditStudentCommand}" Margin="0,0,8,0"/>
                <Button Content="❌ Xóa" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteStudentCommand}" Margin="0,0,12,0"/>
                <Button Content="🔑 Nhận phòng (Check-in)" Style="{StaticResource PrimaryButton}" Command="{Binding CheckInCommand}" Margin="0,0,8,0"/>
                <Button Content="🚪 Trả phòng (Check-out)" Style="{StaticResource SecondaryButton}" Command="{Binding CheckOutCommand}" Margin="0,0,16,0"/>
                <Button Content="🔄 Tải lại" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Search & Filter Bar -->
        <Border Grid.Row="1" Style="{StaticResource CardFrame}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🔍 Tìm kiếm sinh viên (Họ tên / Mã SV / Ngành học / Lớp)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    <TextBlock Text="🚪 Xem Theo Phòng" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoomFilter}" Height="38" Style="{StaticResource ModernComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RoomNumber}" Foreground="White" FontSize="13"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Student DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardFrame}">
            <DataGrid ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã SV" Binding="{Binding StudentCode}" Width="100"/>
                    <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="180" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Ngành Học" Binding="{Binding Major}" Width="160"/>
                    <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="100"/>
                    <DataGridTextColumn Header="Giới Tính" Binding="{Binding Gender}" Width="90"/>
                    <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding PhoneNumber}" Width="130"/>
                    <DataGridTextColumn Header="Tòa Nhà" Binding="{Binding BuildingName}" Width="120"/>
                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomNumber}" Width="100"/>
                    <DataGridTextColumn Header="Giường" Binding="{Binding BedNumber}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
