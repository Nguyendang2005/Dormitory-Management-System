<UserControl x:Class="DormCare.WPF.Views.Manager.StudentManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <Border Grid.Row="0" Style="{StaticResource HeaderCard}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,10,0" Style="{StaticResource SearchTextBox}"/>
                    <Button Content="🔄 Tải lại dữ liệu" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="👥 QUẢN LÝ SINH VIÊN KÝ TÚC XÁ" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Danh sách 30 sinh viên nội trú, ngành học, lớp và phân phòng ở thực tế" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Student DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <DataGrid ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã SV" Binding="{Binding StudentCode}" Width="110"/>
                    <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="180"/>
                    <DataGridTextColumn Header="Ngành Học" Binding="{Binding Major}" Width="170"/>
                    <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="100"/>
                    <DataGridTextColumn Header="Giới Tính" Binding="{Binding Gender}" Width="90"/>
                    <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding PhoneNumber}" Width="130"/>
                    <DataGridTextColumn Header="Tòa Nhà" Binding="{Binding BuildingName}" Width="130"/>
                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomNumber}" Width="100"/>
                    <DataGridTextColumn Header="Giường" Binding="{Binding BedNumber}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
