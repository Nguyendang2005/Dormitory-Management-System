<UserControl x:Class="DormCare.WPF.Views.Manager.StudentManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Quản Lý Sinh Viên" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Thêm, sửa, xóa, tìm kiếm sinh viên và quản lý Check-in / Check-out" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Content="👁️ Chi tiết" Style="{StaticResource PrimaryButton}" Command="{Binding ViewDetailCommand}" Margin="0,0,8,0"/>
                <Button Content="✏️ Sửa" Style="{StaticResource PrimaryButton}" Command="{Binding EditCommand}" Margin="0,0,8,0"/>
                <Button Content="🗑️ Xóa" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="0,0,8,0"/>
                <Border Width="1" Background="{StaticResource CardBorderBrush}" Margin="4,4,12,4"/>
                <Button Content="✅ Check-in" Style="{StaticResource PrimaryButton}" Command="{Binding CheckInCommand}" Margin="0,0,8,0"/>
                <Button Content="🚪 Check-out" Style="{StaticResource PrimaryButton}" Command="{Binding CheckOutCommand}" Margin="0,0,8,0"/>
                <Button Content="🔄 Tải lại" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Advanced Search & Multi-Filter Bar -->
        <Border Grid.Row="1" Style="{StaticResource CardFrame}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Keyword -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="🔍 Tìm kiếm sinh viên (Họ tên / Mã SV / Email / SĐT / Ngành / Lớp)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Room Filter -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="🚪 Phòng ở" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding RoomFilterOptions}" SelectedItem="{Binding SelectedRoomFilter}" Style="{StaticResource ModernComboBox}"/>
                </StackPanel>

                <!-- Gender Filter -->
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="👤 Giới tính" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding GenderFilterOptions}" SelectedItem="{Binding SelectedGenderFilter}" Style="{StaticResource ModernComboBox}"/>
                </StackPanel>

                <!-- Status Filter -->
                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Text="⚡ Trạng thái" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}" Style="{StaticResource ModernComboBox}"/>
                </StackPanel>

                <!-- Clear Filters Button -->
                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <Button Content="❌ Xóa Lọc" Style="{StaticResource SecondaryButton}" Height="38" Command="{Binding ClearFiltersCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Student DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardFrame}">
            <DataGrid ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã SV" Binding="{Binding StudentCode}" Width="100"/>
                    <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="180" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Ngày Sinh" Binding="{Binding DateOfBirth, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Giới Tính" Binding="{Binding Gender}" Width="80"/>
                    <DataGridTextColumn Header="Ngành Học" Binding="{Binding Major}" Width="150"/>
                    <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="90"/>
                    <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding PhoneNumber}" Width="120"/>
                    <DataGridTextColumn Header="Tòa Nhà" Binding="{Binding BuildingName}" Width="110"/>
                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomNumber}" Width="120"/>
                    <DataGridTextColumn Header="Giường" Binding="{Binding BedNumber}" Width="80"/>
                    <DataGridTextColumn Header="Ngày Vào Ở" Binding="{Binding CheckInDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Summary Footer -->
        <TextBlock Grid.Row="3" Text="{Binding SummaryText}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="4,10,0,0"/>
    </Grid>
</UserControl>
