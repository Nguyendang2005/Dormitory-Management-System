<Window x:Class="DormCare.WPF.Views.Manager.RoomDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DormCare.WPF.Converters"
        Title="{Binding Title}" Height="760" Width="960"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F8FAFC" Foreground="#0F172A"
        MinHeight="600" MinWidth="780">

    <Window.Resources>
        <conv:StatusToColorConverter x:Key="StatusColorConverter"/>
        <conv:IntToVisibilityConverter x:Key="Tab0" TargetValue="0"/>
        <conv:IntToVisibilityConverter x:Key="Tab1" TargetValue="1"/>
        <conv:IntToVisibilityConverter x:Key="Tab2" TargetValue="2"/>
        <conv:IntToVisibilityConverter x:Key="Tab3" TargetValue="3"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════ HEADER ═══════════════════════ -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,18">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕ Đóng" Click="Close_Click"
                        Style="{StaticResource TabBtn}" Background="#F1F5F9" Foreground="#475569" Height="36" Padding="12,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="10" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,14,0">
                        <TextBlock Text="🚪" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                                <TextBlock Text="{Binding RoomDetail.RoomNumber}" FontSize="16" FontWeight="Bold" Foreground="#0284C7"/>
                            </Border>
                            <TextBlock Text="{Binding RoomDetail.BuildingName, StringFormat='Tòa {0}'}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="#64748B" Margin="0,4,0,0">
                            <Run Text="Tầng"/>
                            <Run Text="{Binding RoomDetail.FloorNumber}"/>
                            <Run Text="  •  Loại:"/>
                            <Run Text="{Binding RoomDetail.RoomType}"/>
                            <Run Text="  •  Giá:"/>
                            <Run Text="{Binding RoomDetail.MonthlyRent, StringFormat='{}{0:N0} VNĐ/tháng'}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════ TAB BAR ═══════════════════════ -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,0">
            <StackPanel Orientation="Horizontal" Height="48">
                <Button Content="📊 Tổng quan" Command="{Binding SelectTabCommand}" CommandParameter="0" Margin="0,0,4,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="0">
                                    <Setter Property="Background" Value="#0EA5E9"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="🛏 Sơ đồ giường" Command="{Binding SelectTabCommand}" CommandParameter="1" Margin="0,0,4,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="1">
                                    <Setter Property="Background" Value="#0EA5E9"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="👥 Sinh viên đang ở" Command="{Binding SelectTabCommand}" CommandParameter="2" Margin="0,0,4,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="2">
                                    <Setter Property="Background" Value="#0EA5E9"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="📋 Lịch sử cư trú" Command="{Binding SelectTabCommand}" CommandParameter="3">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="3">
                                    <Setter Property="Background" Value="#0EA5E9"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════ TAB CONTENT ═══════════════════════ -->
        <Grid Grid.Row="2" Margin="20,14">

            <!-- ─── TAB 0: TỔNG QUAN ─── -->
            <ScrollViewer Visibility="{Binding ActiveTab, Converter={StaticResource Tab0}}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 4 Metric Cards -->
                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="SỨC CHỨA" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding RoomDetail.Capacity, StringFormat='{}{0} giường'}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="12" Margin="2,0,4,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="ĐANG Ở" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding RoomDetail.OccupiedBeds}" FontSize="20" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="2,0,4,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="CÒN TRỐNG" FontSize="10" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding RoomDetail.AvailableBeds}" FontSize="20" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="12" Margin="6,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="BẢO TRÌ" FontSize="10" FontWeight="Bold" Foreground="#B45309" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding RoomDetail.MaintenanceBeds}" FontSize="20" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Progress bar -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="TỶ LỆ LẤP ĐẦY" FontSize="12" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Text="{Binding RoomDetail.OccupancyRate, Mode=OneWay, StringFormat='{}{0:F1}%'}" FontSize="14" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Grid Height="12">
                                <Border Background="#E0F2FE" CornerRadius="6"/>
                                <ProgressBar Value="{Binding RoomDetail.OccupancyRate, Mode=OneWay}" Minimum="0" Maximum="100" Height="12" BorderThickness="0" Background="Transparent" Foreground="#0284C7"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Room info -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="THÔNG TIN PHÒNG" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Tòa nhà:" Foreground="#64748B" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RoomDetail.BuildingName}" FontWeight="SemiBold" FontSize="13"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Số phòng:" Foreground="#64748B" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RoomDetail.RoomNumber}" FontWeight="SemiBold" FontSize="13"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Tầng:" Foreground="#64748B" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RoomDetail.FloorNumber, StringFormat='Tầng {0}'}" FontWeight="SemiBold" FontSize="13"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text=" " FontSize="11" FontWeight="Bold" Foreground="Transparent" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Loại phòng:" Foreground="#64748B" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RoomDetail.RoomType}" FontWeight="SemiBold" FontSize="13"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Giá thuê:" Foreground="#64748B" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RoomDetail.MonthlyRent, StringFormat='{}{0:N0} VNĐ'}" FontWeight="SemiBold" FontSize="13" Foreground="#0284C7"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Giới tính:" Foreground="#64748B" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RoomDetail.GenderType}" FontWeight="SemiBold" FontSize="13"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ─── TAB 1: SƠ ĐỒ GIƯỜNG ─── -->
            <ScrollViewer Visibility="{Binding ActiveTab, Converter={StaticResource Tab1}}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="🛏️ SƠ ĐỒ CÁC GIƯỜNG TRONG PHÒNG" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding RoomDetail.Beds}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="16" Margin="0,0,10,10" BorderThickness="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- Available default -->
                                            <Setter Property="Background" Value="#ECFDF5"/>
                                            <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                    <Setter Property="BorderBrush" Value="#93C5FD"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Reserved">
                                                    <Setter Property="Background" Value="#FEF9C3"/>
                                                    <Setter Property="BorderBrush" Value="#FDE047"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Maintenance">
                                                    <Setter Property="Background" Value="#FFF1F2"/>
                                                    <Setter Property="BorderBrush" Value="#FECDD3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- Bed code + status -->
                                        <DockPanel Margin="0,0,0,8">
                                            <Border DockPanel.Dock="Right" CornerRadius="6" Padding="8,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#D1FAE5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Maintenance">
                                                                <Setter Property="Background" Value="#FFE4E6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Reserved">
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusVietnamese}" FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Maintenance">
                                                                    <Setter Property="Foreground" Value="#BE123C"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Reserved">
                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding BedCode}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- Icon giường -->
                                        <TextBlock FontSize="32" HorizontalAlignment="Center" Margin="0,4,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="🛏️"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                            <Setter Property="Text" Value="🧑"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Maintenance">
                                                            <Setter Property="Text" Value="🔧"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Reserved">
                                                            <Setter Property="Text" Value="📌"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Student info (nếu Occupied) -->
                                        <TextBlock Text="{Binding StudentName}" FontSize="13" FontWeight="SemiBold" Foreground="#1E3A5F" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding StudentCode}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding StartDateDisplay, StringFormat='Từ {0}'}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Empty state -->
                                        <TextBlock Text="Còn trống" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" FontStyle="Italic">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Available">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ─── TAB 2: SINH VIÊN ĐANG Ở ─── -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource Tab2}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="👥 SINH VIÊN ĐANG CƯ TRÚ TRONG PHÒNG" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,12"/>
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10">
                    <DataGrid ItemsSource="{Binding Residents}" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource ModernDataGrid}" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã SV" Binding="{Binding StudentCode}" Width="110" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Mã giường" Binding="{Binding BedCode}" Width="110"/>
                            <DataGridTextColumn Header="Ngày vào" Binding="{Binding StartDateDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Loại phân phòng" Binding="{Binding AssignmentTypeDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Người phân" Binding="{Binding AssignedByName}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ─── TAB 3: LỊCH SỬ CƯ TRÚ ─── -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource Tab3}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="📋 LỊCH SỬ CƯ TRÚ TOÀN BỘ PHÒNG" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,12"/>
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10">
                    <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource ModernDataGrid}" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã SV" Binding="{Binding StudentCode}" Width="100" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Giường" Binding="{Binding BedCode}" Width="100"/>
                            <DataGridTextColumn Header="Ngày vào" Binding="{Binding StartDateDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Ngày ra" Binding="{Binding EndDateDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Thời gian" Binding="{Binding DurationDisplay}" Width="90"/>
                            <DataGridTemplateColumn Header="Trạng thái" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Ended">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Ended">
                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════════════ FOOTER ═══════════════════════ -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center">
                    <Run Text="{Binding RoomDetail.OccupancyText}"/>
                    <Run Text=" người  •  "/>
                    <Run Text="{Binding RoomDetail.OccupancyRate, Mode=OneWay, StringFormat='Tỷ lệ lấp đầy: {0:F1}%'}" FontWeight="Bold" Foreground="#0284C7"/>
                </TextBlock>
                <Button DockPanel.Dock="Right" Content="Đóng" Click="Close_Click"
                        Width="120" Height="36" Style="{StaticResource PrimaryButton}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
