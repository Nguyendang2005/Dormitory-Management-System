<Window x:Class="DormCare.WPF.Views.Manager.BuildingDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi Tiết Tòa Nhà" Height="640" Width="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFFFFF" Foreground="#0F172A">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border Width="48" Height="48" CornerRadius="10" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,14,0" DockPanel.Dock="Left">
                    <TextBlock Text="🏢" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Building.BuildingCode}" FontSize="16" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>
                        <TextBlock Text="—" FontSize="18" Foreground="#94A3B8" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Building.BuildingName}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Building.Address, StringFormat='📍 {0}'}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Metrics Grid & Occupancy Bar Card -->
        <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="#CBD5E1" BorderThickness="1">
            <StackPanel>
                <UniformGrid Columns="3" Margin="0,0,0,14">
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SỐ TẦNG" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Building.NumberOfFloors}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="3,0,3,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TỔNG PHÒNG" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Building.TotalRooms}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TỔNG GIƯỜNG" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Building.TotalBeds}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Detailed Bed Breakdown -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="👤 Đang ở: " FontSize="13" Foreground="#475569"/>
                        <TextBlock Text="{Binding Building.OccupiedBeds}" FontSize="14" FontWeight="Bold" Foreground="#0284C7"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🛏️ Còn trống: " FontSize="13" Foreground="#475569"/>
                        <TextBlock Text="{Binding Building.AvailableBeds}" FontSize="14" FontWeight="Bold" Foreground="#059669"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🛠️ Bảo trì: " FontSize="13" Foreground="#475569"/>
                        <TextBlock Text="{Binding Building.MaintenanceBeds}" FontSize="14" FontWeight="Bold" Foreground="#D97706"/>
                    </StackPanel>
                </Grid>

                <!-- Occupancy Rate Bar -->
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="TỶ LỆ LẤP ĐẦY" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                        <TextBlock Text="{Binding Building.OccupancyRate, StringFormat='{}{0:F1}%'}" FontSize="13" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Grid Height="10">
                        <Border Background="#E0F2FE" CornerRadius="5"/>
                        <ProgressBar Value="{Binding Building.OccupancyRate, Mode=OneWay}" Minimum="0" Maximum="100" Height="10" BorderThickness="0" Background="Transparent" Foreground="#0284C7"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Room List Section -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="12" Padding="16" BorderBrush="#CBD5E1" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="📋 DANH SÁCH PHÒNG TRONG TÒA NHÀ" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Building.Rooms}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Phòng" Binding="{Binding RoomNumber}" Width="100" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Tầng" Binding="{Binding FloorNumber, StringFormat='{}Tầng {0}'}" Width="90"/>
                        <DataGridTextColumn Header="Sức Chứa" Binding="{Binding Capacity, StringFormat='{}{0} giường'}" Width="100"/>
                        <DataGridTextColumn Header="Hiện Có" Binding="{Binding OccupancyText}" Width="100" FontWeight="Bold"/>
                        <DataGridTemplateColumn Header="Trạng Thái" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusDisplay}" Value="Còn chỗ">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusDisplay}" Value="Đã đầy">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusDisplay}" Value="Bảo trì">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#475569"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusDisplay}" Value="Còn chỗ">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusDisplay}" Value="Đã đầy">
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusDisplay}" Value="Bảo trì">
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Actions -->
        <Border Grid.Row="3" Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Button Content="Đóng" Click="Close_Click" Style="{StaticResource PrimaryButton}" Width="120" Height="38" HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</Window>
