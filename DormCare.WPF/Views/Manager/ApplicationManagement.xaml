<UserControl x:Class="DormCare.WPF.Views.Manager.ApplicationManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DormCare.WPF.Converters">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderCard}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="✅ Duyệt Đơn" Style="{StaticResource PrimaryButton}" Command="{Binding ApproveCommand}" Margin="0,0,8,0"/>
                    <Button Content="❌ Từ Chối" Style="{StaticResource SmallDangerButton}" Command="{Binding RejectCommand}" Height="36" Padding="12,0" Margin="0,0,8,0"/>
                    <Button Content="🔄 Tải Lại Dữ Liệu" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📝 QUẢN LÝ ĐƠN ĐĂNG KÝ PHÒNG" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Xét duyệt hồ sơ xin lưu trú ký túc xá của sinh viên theo thời gian thực" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Search & Filter Bar -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Tìm kiếm đơn (Mã Đơn / Mã SV / Họ tên / Số phòng)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource SearchTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Lọc Trạng Thái Đơn" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="Tất cả trạng thái" Tag="All" IsSelected="True"/>
                        <ComboBoxItem Content="Chờ duyệt (Pending)" Tag="Pending"/>
                        <ComboBoxItem Content="Đã duyệt (Approved)" Tag="Approved"/>
                        <ComboBoxItem Content="Từ chối (Rejected)" Tag="Rejected"/>
                        <ComboBoxItem Content="Đã hủy (Cancelled)" Tag="Cancelled"/>
                    </ComboBox>
                </StackPanel>

                <Button Grid.Column="2" Content="Đặt lại" Style="{StaticResource SecondaryButton}" Command="{Binding ResetFiltersCommand}" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- Main Content: Left DataGrid + Right Application Review Detail Panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                <DataGrid ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Đơn" Binding="{Binding ApplicationCode}" Width="130" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Sinh Viên" Binding="{Binding Student.FullName}" Width="160"/>
                        <DataGridTextColumn Header="Mã SV" Binding="{Binding Student.StudentCode}" Width="95"/>
                        <DataGridTextColumn Header="Phòng" Binding="{Binding Room.RoomNumber}" Width="80"/>
                        <DataGridTextColumn Header="Tòa Nhà" Binding="{Binding Room.Building.BuildingName}" Width="130"/>
                        <DataGridTextColumn Header="Giường" Binding="{Binding PreferredBed.BedCode}" Width="100"/>
                        <DataGridTextColumn Header="Ngày Đăng Ký" Binding="{Binding ApplicationDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="135"/>
                        <DataGridTemplateColumn Header="Trạng Thái" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                            CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Chi Tiết Đơn Đăng Ký" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Mã Đơn:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SelectedApplication.ApplicationCode}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Sinh Viên:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SelectedApplication.Student.FullName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Mã SV:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SelectedApplication.Student.StudentCode}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Phòng Đăng Ký:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SelectedApplication.Room.RoomNumber}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Tòa Nhà:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SelectedApplication.Room.Building.BuildingName}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Giường Nguyện Vọng:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SelectedApplication.PreferredBed.BedCode}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Trạng Thái Đơn:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SelectedApplication.Status}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="Lý do / Ghi chú đăng ký:" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"/>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                            <TextBlock Text="{Binding SelectedApplication.Note}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>

                        <TextBlock Text="Ghi chú xét duyệt (Admin):" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding ReviewNote, UpdateSourceTrigger=PropertyChanged}"
                                 Height="80"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="✅ Duyệt" Style="{StaticResource PrimaryButton}" Command="{Binding ApproveCommand}" Margin="0,0,8,0"/>
                            <Button Content="❌ Từ Chối" Style="{StaticResource SmallDangerButton}" Command="{Binding RejectCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
