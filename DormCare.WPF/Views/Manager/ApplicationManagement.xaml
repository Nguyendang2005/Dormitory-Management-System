<UserControl x:Class="DormCare.WPF.Views.Manager.ApplicationManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DormCare.WPF.Converters">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Đơn Đăng Ký Phòng" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Xét duyệt đơn xin ở ký túc xá của sinh viên" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="✅ Duyệt Đơn" Style="{StaticResource PrimaryButton}" Command="{Binding ApproveCommand}" Margin="0,0,10,0"/>
                <Button Content="❌ Từ Chối" Style="{StaticResource DangerButton}" Command="{Binding RejectCommand}" Margin="0,0,10,0"/>
                <Button Content="🔄 Tải lại" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Search & Filter Bar -->
        <Border Grid.Row="1" Style="{StaticResource CardFrame}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="🔍 Tìm kiếm đơn (Mã Đơn / Mã SV / Họ tên / Số phòng)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="⚡ Lọc Trạng Thái Đơn" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}" SelectedValuePath="Tag" Height="38" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource CardBorderBrush}">
                        <ComboBoxItem Content="Tất cả trạng thái" Tag="All" IsSelected="True"/>
                        <ComboBoxItem Content="Chờ duyệt (Pending)" Tag="Pending"/>
                        <ComboBoxItem Content="Đã duyệt (Approved)" Tag="Approved"/>
                        <ComboBoxItem Content="Từ chối (Rejected)" Tag="Rejected"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardFrame}">
            <DataGrid ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Đơn" Binding="{Binding ApplicationId}" Width="70"/>
                    <DataGridTextColumn Header="Mã Code" Binding="{Binding ApplicationCode}" Width="130" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Sinh Viên" Binding="{Binding Student.FullName}" Width="160"/>
                    <DataGridTextColumn Header="Mã SV" Binding="{Binding Student.StudentCode}" Width="100"/>
                    <DataGridTextColumn Header="Phòng ĐK" Binding="{Binding Room.RoomNumber}" Width="100"/>
                    <DataGridTextColumn Header="Tòa Nhà" Binding="{Binding Room.Building.BuildingName}" Width="140"/>
                    <DataGridTextColumn Header="Ngày Đăng Ký" Binding="{Binding ApplicationDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150"/>
                    <DataGridTemplateColumn Header="Trạng Thái" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                        CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Ghi Chú Admin" Binding="{Binding ReviewNote}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
