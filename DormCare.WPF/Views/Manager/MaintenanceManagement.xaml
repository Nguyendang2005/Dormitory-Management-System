<UserControl x:Class="DormCare.WPF.Views.Manager.MaintenanceManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DormCare.WPF.Converters">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusColorConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Báo Cáo &amp; Sửa Chữa Thất Bát/Hư Hỏng" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Quản lý yêu cầu khắc phục sự cố CSVC trong phòng" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🛠️ Đánh Dấu Hoàn Thành" Style="{StaticResource PrimaryButton}" Command="{Binding CompleteRequestCommand}" Margin="0,0,10,0"/>
                <Button Content="🔄 Tải lại" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Search & Filter Bar -->
        <Border Grid.Row="1" Style="{StaticResource CardFrame}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="🔍 Tìm kiếm yêu cầu (Tiêu đề / Mã YC / Sinh viên / Phòng)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="⚡ Lọc Mức Độ Ưu Tiên" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox SelectedValue="{Binding SelectedPriorityFilter, Mode=TwoWay}" SelectedValuePath="Tag" Height="38" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource CardBorderBrush}">
                        <ComboBoxItem Content="Tất cả mức độ" Tag="All" IsSelected="True"/>
                        <ComboBoxItem Content="Thấp (Low)" Tag="Low"/>
                        <ComboBoxItem Content="Trung bình (Medium)" Tag="Medium"/>
                        <ComboBoxItem Content="Cao (High)" Tag="High"/>
                        <ComboBoxItem Content="Khẩn cấp (Critical)" Tag="Critical"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardFrame}" Margin="0,0,0,16">
            <DataGrid ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Đang xử lý (In Progress)" Command="{Binding MarkInProgressCommand}"/>
                        <MenuItem Header="Đánh dấu hoàn thành (Resolved)" Command="{Binding CompleteRequestCommand}"/>
                        <MenuItem Header="Đóng yêu cầu (Closed)" Command="{Binding CloseRequestCommand}"/>
                        <Separator/>
                        <MenuItem Header="Đặt mức độ ưu tiên">
                            <MenuItem Header="Thấp (Low)" Command="{Binding SetPriorityCommand}" CommandParameter="Low"/>
                            <MenuItem Header="Trung bình (Medium)" Command="{Binding SetPriorityCommand}" CommandParameter="Medium"/>
                            <MenuItem Header="Cao (High)" Command="{Binding SetPriorityCommand}" CommandParameter="High"/>
                            <MenuItem Header="Khẩn cấp (Critical)" Command="{Binding SetPriorityCommand}" CommandParameter="Critical"/>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã YC" Binding="{Binding RequestId}" Width="70"/>
                    <DataGridTextColumn Header="Mã Code" Binding="{Binding RequestCode}" Width="130" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Tiêu Đề" Binding="{Binding Title}" Width="180"/>
                    <DataGridTextColumn Header="Mô Tả Chi Tiết" Binding="{Binding Description}" Width="230"/>
                    <DataGridTextColumn Header="Sinh Viên" Binding="{Binding Student.FullName}" Width="150"/>
                    <DataGridTextColumn Header="Phòng" Binding="{Binding Room.RoomNumber}" Width="100"/>
                    <DataGridTextColumn Header="Độ Ưu Tiên" Binding="{Binding Priority}" Width="110"/>
                    <DataGridTemplateColumn Header="Trạng Thái" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                        CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- New Request Panel with Validation Banner -->
        <Border Grid.Row="3" Style="{StaticResource CardFrame}">
            <StackPanel>
                <TextBlock Text="➕ Gửi Yêu Cầu Sửa Chữa Mới (Dành cho Sinh Viên)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryHoverBrush}" Margin="0,0,0,12"/>

                <!-- Validation Error Alert Banner -->
                <Border Style="{StaticResource ValidationBanner}" Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#FCA5A5" FontWeight="Bold" FontSize="13"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="Gửi Yêu Cầu" Style="{StaticResource PrimaryButton}" Command="{Binding CreateRequestCommand}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
