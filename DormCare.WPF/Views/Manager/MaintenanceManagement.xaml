<UserControl x:Class="DormCare.WPF.Views.Manager.MaintenanceManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DormCare.WPF.Converters">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusColorConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderCard}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🛠️ Đánh Dấu Hoàn Thành" Style="{StaticResource PrimaryButton}" Command="{Binding CompleteRequestCommand}" Margin="0,0,8,0"/>
                    <Button Content="🔄 Tải Lại Dữ Liệu" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🛠️ QUẢN LÝ YÊU CẦU SỬA CHỮA &amp; BẢO TRÌ" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Xử lý và cập nhật tiến độ giải quyết các báo cáo sự cố cơ sở vật chất từ sinh viên" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Search & Multi-Filter Bar -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="🔍 Tìm kiếm yêu cầu (Tiêu đề / Mã YC / Sinh viên / Phòng)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource SearchTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="⚡ Mức Độ Ưu Tiên" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox SelectedValue="{Binding SelectedPriorityFilter, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="Tất cả mức độ" Tag="All" IsSelected="True"/>
                        <ComboBoxItem Content="Thấp (Low)" Tag="Low"/>
                        <ComboBoxItem Content="Trung bình (Medium)" Tag="Medium"/>
                        <ComboBoxItem Content="Cao (High)" Tag="High"/>
                        <ComboBoxItem Content="Khẩn cấp (Critical)" Tag="Critical"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="📌 Trạng Thái Xử Lý" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="Tất cả trạng thái" Tag="All" IsSelected="True"/>
                        <ComboBoxItem Content="⏳ Chờ xử lý (Pending)" Tag="Pending"/>
                        <ComboBoxItem Content="⚙️ Đang sửa (InProgress)" Tag="InProgress"/>
                        <ComboBoxItem Content="✅ Hoàn thành (Completed)" Tag="Completed"/>
                        <ComboBoxItem Content="❌ Đã hủy (Cancelled)" Tag="Cancelled"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <Button Content="❌ Xóa Lọc" Style="{StaticResource SecondaryButton}" Height="36" Command="{Binding ClearFiltersCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <DataGrid ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest}" Style="{StaticResource ModernDataGrid}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Đang xử lý (In Progress)" Command="{Binding MarkInProgressCommand}"/>
                        <MenuItem Header="Đánh dấu hoàn thành (Resolved)" Command="{Binding CompleteRequestCommand}"/>
                        <MenuItem Header="Đóng yêu cầu (Closed)" Command="{Binding CloseRequestCommand}"/>
                        <Separator/>
                        <MenuItem Header="Đặt mức độ ưu tiên">
                            <MenuItem Header="Thấp (Low)" Command="{Binding SetPriorityCommand}" CommandParameter="Low"/>
                            <MenuItem Header="Trung bình (Medium)" Command="{Binding SetPriorityCommand}" CommandParameter="Medium"/>
                            <MenuItem Header="Cao (High)" Command="{Binding SetPriorityCommand}" CommandParameter="High"/>
                            <MenuItem Header="Khẩn cấp (Critical)" Command="{Binding SetPriorityCommand}" CommandParameter="Critical"/>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã YC" Binding="{Binding RequestId}" Width="70"/>
                    <DataGridTextColumn Header="Mã Code" Binding="{Binding RequestCode}" Width="130" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Tiêu Đề" Binding="{Binding Title}" Width="180"/>
                    <DataGridTextColumn Header="Mô Tả Chi Tiết" Binding="{Binding Description}" Width="220"/>
                    <DataGridTextColumn Header="Sinh Viên" Binding="{Binding Student.FullName}" Width="150"/>
                    <DataGridTextColumn Header="Phòng" Binding="{Binding Room.RoomNumber}" Width="100"/>
                    <DataGridTextColumn Header="Độ Ưu Tiên" Binding="{Binding Priority}" Width="110"/>
                    <DataGridTemplateColumn Header="Trạng Thái" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                        CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- New Request Panel with Validation Banner -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="➕ Tạo Yêu Cầu Sửa Chữa Mới" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>

                <!-- Validation Error Alert Banner -->
                <Border Style="{StaticResource ValidationBanner}" Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#DC2626" FontWeight="Bold" FontSize="13"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource SearchTextBox}" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="Gửi Yêu Cầu" Style="{StaticResource PrimaryButton}" Command="{Binding CreateRequestCommand}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
