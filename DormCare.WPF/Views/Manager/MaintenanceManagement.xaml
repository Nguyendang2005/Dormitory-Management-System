<UserControl x:Class="DormCare.WPF.Views.Manager.MaintenanceManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DormCare.WPF.Converters">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusColorConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderCard}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Đổi trạng thái:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <ComboBox SelectedValue="{Binding SelectedUpdateStatus, Mode=TwoWay}" SelectedValuePath="Tag" Width="130" Margin="0,0,8,0" Style="{StaticResource ModernComboBox}" IsEnabled="{Binding IsRequestSelected}">
                        <ComboBoxItem Content="⏳ Chờ xử lý" Tag="Submitted"/>
                        <ComboBoxItem Content="⚙️ Đang sửa" Tag="InProgress"/>
                        <ComboBoxItem Content="✅ Hoàn thành" Tag="Resolved"/>
                        <ComboBoxItem Content="❌ Đã hủy" Tag="Closed"/>
                    </ComboBox>
                    <TextBlock Text="Ghi chú / Thông báo:" VerticalAlignment="Center" Margin="8,0,8,0" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBox Text="{Binding UpdateMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0" Style="{StaticResource SearchTextBox}" IsEnabled="{Binding IsRequestSelected}" />
                    <Button Content="💾 Cập nhật" Style="{StaticResource PrimaryButton}" Command="{Binding UpdateSelectedStatusCommand}" Margin="0,0,8,0"/>
                    <Button Content="🔄 Tải Lại Dữ Liệu" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🛠️ QUẢN LÝ YÊU CẦU SỬA CHỮA &amp; BẢO TRÌ" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Xử lý và cập nhật tiến độ giải quyết các báo cáo sự cố cơ sở vật chất từ sinh viên" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Top Bar: Filters and Create -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Filters -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                        <TextBlock Text="🔍 Tìm kiếm yêu cầu (Tiêu đề / Mã YC / Sinh viên / Phòng)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource SearchTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" Orientation="Horizontal">
                        <StackPanel Margin="0,0,12,0" MinWidth="150">
                            <TextBlock Text="📌 Trạng Thái Xử Lý" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="Tất cả trạng thái" Tag="All" IsSelected="True"/>
                                <ComboBoxItem Content="⏳ Chờ xử lý (Pending)" Tag="Pending"/>
                                <ComboBoxItem Content="⚙️ Đang sửa (InProgress)" Tag="InProgress"/>
                                <ComboBoxItem Content="✅ Hoàn thành (Completed)" Tag="Completed"/>
                                <ComboBoxItem Content="❌ Đã hủy (Cancelled)" Tag="Cancelled"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel MinWidth="150">
                            <TextBlock Text="🔥 Mức Độ Ưu Tiên" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding SelectedPriorityFilter, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="Tất cả mức độ" Tag="All" IsSelected="True"/>
                                <ComboBoxItem Content="Thấp (Low)" Tag="Low"/>
                                <ComboBoxItem Content="Trung bình (Medium)" Tag="Medium"/>
                                <ComboBoxItem Content="Cao (High)" Tag="High"/>
                                <ComboBoxItem Content="Khẩn cấp (Critical)" Tag="Critical"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Row="1" Grid.Column="1" Content="❌ Xóa Lọc" Style="{StaticResource SecondaryButton}" Height="36" VerticalAlignment="Bottom" Command="{Binding ClearFiltersCommand}"/>
                </Grid>
            </Border>

            <!-- Create Request -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="➕ Tạo Yêu Cầu Sửa Chữa Mới" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#DC2626" FontWeight="Bold" FontSize="12" Margin="12,0,0,0" Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisConverter}}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Tiêu đề" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding NewTitle, Mode=TwoWay}" SelectedValuePath="Content" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="Điện (Đèn, Ổ cắm, Quạt)"/>
                                <ComboBoxItem Content="Nước (Vòi, Đường ống, Vệ sinh)"/>
                                <ComboBoxItem Content="Máy lạnh / Điều hòa"/>
                                <ComboBoxItem Content="Nội thất (Giường, Bàn, Tủ)"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Mô tả chi tiết" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource SearchTextBox}" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Số phòng" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Rooms}" SelectedValue="{Binding SelectedNewRoomId, Mode=TwoWay}" SelectedValuePath="RoomId" DisplayMemberPath="RoomNumber" Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                            <TextBlock Text="Mức độ ưu tiên" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding NewPriority, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="Thấp" Tag="Low"/>
                                <ComboBoxItem Content="Trung bình" Tag="Medium"/>
                                <ComboBoxItem Content="Cao" Tag="High"/>
                                <ComboBoxItem Content="Khẩn cấp" Tag="Critical"/>
                            </ComboBox>
                        </StackPanel>

                        <Button Grid.Column="4" Content="Gửi" Style="{StaticResource PrimaryButton}" Height="36" VerticalAlignment="Bottom" Command="{Binding CreateRequestCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <DataGrid ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest}" Style="{StaticResource ModernDataGrid}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Đang xử lý (In Progress)" Command="{Binding MarkInProgressCommand}"/>
                        <MenuItem Header="Đánh dấu hoàn thành (Resolved)" Command="{Binding CompleteRequestCommand}"/>
                        <MenuItem Header="Đóng yêu cầu (Closed)" Command="{Binding CloseRequestCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã YC" Binding="{Binding RequestId}" Width="70"/>
                    <DataGridTextColumn Header="Mã Code" Binding="{Binding RequestCode}" Width="130" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Tiêu Đề" Binding="{Binding Title}" Width="180"/>
                    <DataGridTextColumn Header="Mô Tả Chi Tiết" Binding="{Binding Description}" Width="220"/>
                    <DataGridTextColumn Header="Sinh Viên" Binding="{Binding Student.FullName}" Width="150"/>
                    <DataGridTextColumn Header="Phòng" Binding="{Binding Room.RoomNumber}" Width="90"/>
                    
                    <DataGridTemplateColumn Header="Ưu Tiên" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Priority}" VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Trạng Thái" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                        CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>


    </Grid>
</UserControl>
