<UserControl x:Class="DormCare.WPF.Views.Manager.BuildingManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DormCare.WPF.Converters">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="🔵 Dạng — Quản Lý Tòa Nhà Ký Túc Xá" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Danh sách các tòa nhà, tổng số phòng, số giường và tỷ lệ lấp đầy" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="🔄 Tải lại" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Search & Filter Bar -->
        <Border Grid.Row="1" Style="{StaticResource CardFrame}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="🔍 Tìm kiếm (Mã tòa / Tên tòa)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="⚡ Trạng Thái Tòa Nhà" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}" SelectedValuePath="Tag" Height="38" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource CardBorderBrush}">
                        <ComboBoxItem Content="Tất cả trạng thái" Tag="All" IsSelected="True"/>
                        <ComboBoxItem Content="Hoạt động (Active)" Tag="Active"/>
                        <ComboBoxItem Content="Tạm dừng (Inactive)" Tag="Inactive"/>
                        <ComboBoxItem Content="Bảo trì (Maintenance)" Tag="Maintenance"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Buildings DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardFrame}">
            <DataGrid ItemsSource="{Binding Buildings}" SelectedItem="{Binding SelectedBuilding}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Tòa" Binding="{Binding BuildingCode}" Width="100"/>
                    <DataGridTextColumn Header="Tên Tòa Nhà" Binding="{Binding BuildingName}" Width="180" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Số Tầng" Binding="{Binding NumberOfFloors}" Width="90"/>
                    <DataGridTextColumn Header="Tổng Số Phòng" Binding="{Binding TotalRooms}" Width="120"/>
                    <DataGridTextColumn Header="Tổng Số Giường" Binding="{Binding TotalBeds}" Width="120"/>
                    <DataGridTextColumn Header="Đã Ở" Binding="{Binding OccupiedBeds}" Width="90"/>
                    <DataGridTextColumn Header="Giường Trống" Binding="{Binding AvailableBeds}" Width="110"/>
                    <DataGridTextColumn Header="Tỷ Lệ Lấp Đầy (%)" Binding="{Binding OccupancyRate, StringFormat='{}{0:F1}%'}" Width="140" FontWeight="Bold"/>
                    <DataGridTemplateColumn Header="Trạng Thái" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                        CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
